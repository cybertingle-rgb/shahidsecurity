---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTABand from '@/components/CTABand.astro';
import { Icon } from 'astro-icon/components';
import { site } from '@/lib/site';
import { personSchema, breadcrumbSchema } from '@/lib/schema';

const values = [
  { title: 'Authorised & ethical', text: 'We never test anything without written permission.' },
  {
    title: 'Confidential by default',
    text: 'NDA before access; your data never leaves agreed systems.',
  },
  {
    title: 'Plain language',
    text: 'Reports your management can understand, with fixes your developers can apply.',
  },
  { title: 'Honest scope', text: 'We tell you what you need, not what costs the most.' },
];

const jsonLd = [
  personSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
];

const yearsExperience = new Date().getFullYear() - site.founderExperienceSince;
const initials = 'SI';
---

<BaseLayout
  title="About Shahid Security"
  description="Shahid Security is a Pakistani cybersecurity practice founded by Muhammad Shahid Iqbal — practical, honest security advice, not fear-mongering."
  path="/about/"
  jsonLd={jsonLd}
  ogImage="/og/about.png"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ]}
    />
    <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:items-center">
      <picture class="mx-auto">
        <source srcset="/brand/logo-stacked-dark-bg-sm.webp" type="image/webp" />
        <img
          src="/brand/logo-stacked-dark-bg-sm.png"
          alt="Shahid Security"
          width="320"
          height="502"
          class="h-32 w-auto sm:h-40"
        />
      </picture>
      <div>
        <SectionHeading as="h1" eyebrow="// about" title="About Shahid Security" />
        <p class="mt-6 border-l-2 border-(--color-neon) pl-4 font-display text-xl italic text-(--color-text)">
          "{site.taglineSecondary}"
        </p>
      </div>
    </div>
  </Section>

  <Section class="pt-0">
    <div class="max-w-2xl space-y-5 text-(--color-text-muted) leading-relaxed">
      <p>
        Shahid Security is a Pakistani cybersecurity practice founded by Muhammad Shahid Iqbal. I
        studied Computer Science with a focus on information security, and my final-year project was
        an attack study on an IoT-based smart campus system. Since {site.founderExperienceSince}{' '}
        I've worked as a cybersecurity analyst and SOC analyst — running vulnerability assessments,
        building a honeytrap to capture and study a live intruder on a client network, monitoring
        real security events with SIEM tools, and leading incident response when things went wrong.
      </p>
      <p>
        We started because too many businesses only think about security after something goes wrong.
        Our job is to change that: find the weaknesses early, explain them in plain language, and
        help fix them — at a price growing businesses can afford.
      </p>
      <p>
        Because we also build websites, software and AI systems, we understand both sides: how
        attackers break things and how developers build them. That means our advice is practical,
        not just a list of problems.
      </p>
    </div>
  </Section>

  <Section class="pt-0">
    <div class="glass-card corner-brackets grid gap-8 p-8 sm:grid-cols-[auto_1fr] sm:items-center">
      <div
        class="flex size-28 items-center justify-center rounded-full border border-(--color-neon)/40 bg-(--color-surface) font-display text-2xl font-semibold text-(--color-neon)"
        aria-hidden="true"
      >
        {initials}
      </div>
      <div>
        <h2 class="font-display text-xl font-semibold text-(--color-text)">{site.founder}</h2>
        <p class="text-sm text-(--color-text-muted)">Founder &amp; Security Consultant</p>
        <p class="mt-3 text-sm text-(--color-text-muted)">
          {yearsExperience}+ years in cybersecurity — penetration testing, SOC operations and
          incident response
        </p>
        <p class="mt-1 text-sm text-(--color-text-muted)">
          Training: CompTIA Network+ &amp; Security+ fundamentals, Certified Ethical Hacking (CEH)
          methodology, and CISSP domains
        </p>
        <div class="mt-4 flex gap-4">
          <a
            href={site.social.linkedin}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 font-mono text-xs text-(--color-text-muted) hover:text-(--color-neon)"
          >
            <Icon name="lucide:linkedin" class="size-4" aria-hidden="true" /> LinkedIn
          </a>
          <a
            href={site.social.x}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 font-mono text-xs text-(--color-text-muted) hover:text-(--color-neon)"
          >
            <Icon name="lucide:twitter" class="size-4" aria-hidden="true" /> X
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="// values" title="What we stand for" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="glass-card p-6">
          <h3 class="font-display text-base font-semibold text-(--color-text)">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{v.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <CTABand title="Want to work with us?" text="Book a free consultation — no obligation." />
  </Section>
</BaseLayout>
