---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import FAQ from '@/components/FAQ.astro';
import CTABand from '@/components/CTABand.astro';
import Prose from '@/components/Prose.astro';
import { Icon } from 'astro-icon/components';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import { getCollection, render } from 'astro:content';
import { serviceSchema, faqSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const path = `/services/${service.id}/`;

const relatedCaseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft)).filter(
  (cs) => cs.data.services.some((s) => s.toLowerCase() === service.data.title.toLowerCase()),
);

const authorizationSafety =
  service.data.group === 'security'
    ? 'Every engagement starts with written authorisation and, where appropriate, a signed NDA — we never test a system without the owner’s explicit permission. Testing is scoped and scheduled with you in advance, avoids destructive techniques by default, and stays inside the boundaries agreed before any work begins.'
    : 'Every engagement starts with a signed NDA before we get access to your systems or data. We follow secure coding and data-handling practices throughout, and any security testing of what we build — code review, pre-launch penetration testing — is scoped and agreed with you in advance.';

const jsonLd: object[] = [
  serviceSchema({ name: service.data.title, description: service.data.shortDescription, path }),
];
const faq = faqSchema(service.data.faqs.map((f) => ({ question: f.q, answer: f.a })));
if (faq) jsonLd.push(faq);
---

<BaseLayout
  title={service.data.seoTitle}
  description={service.data.seoDescription}
  path={path}
  jsonLd={jsonLd}
  ogImage={`/og/service-${service.id}.png`}
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Services', path: '/services/' },
        { name: service.data.title, path },
      ]}
    />
    <SectionHeading
      as="h1"
      eyebrow={`// ${String(service.data.order).padStart(2, '0')} ${service.data.group.toUpperCase()}`}
      title={service.data.title}
      intro={service.data.shortDescription}
    />
  </Section>

  <Section class="pt-0">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <Prose>
          <Content />
        </Prose>

        <h2 class="mt-10 font-display text-xl font-semibold text-(--color-text)">
          What's included
        </h2>
        <ul class="mt-4 space-y-2">
          {service.data.included.map((item) => (
            <li class="flex items-start gap-2 text-sm text-(--color-text-muted)">
              <Icon
                name="lucide:check"
                class="mt-0.5 size-4 flex-shrink-0 text-(--color-neon)"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>

        <h2 class="mt-10 font-display text-xl font-semibold text-(--color-text)">
          Our methodology
        </h2>
        <ol class="mt-4 space-y-3">
          {service.data.methodology.map((item, index) => (
            <li class="flex items-start gap-3 text-sm text-(--color-text-muted)">
              <span class="mt-0.5 flex size-5 flex-shrink-0 items-center justify-center rounded-full border border-(--color-neon)/40 font-mono text-[0.65rem] text-(--color-neon)">
                {index + 1}
              </span>
              {item}
            </li>
          ))}
        </ol>

        <h2 class="mt-10 font-display text-xl font-semibold text-(--color-text)">What you get</h2>
        <ul class="mt-4 space-y-2">
          {service.data.deliverables.map((item) => (
            <li class="flex items-start gap-2 text-sm text-(--color-text-muted)">
              <Icon
                name="lucide:file-check-2"
                class="mt-0.5 size-4 flex-shrink-0 text-(--color-neon)"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>

        <h2 class="mt-10 font-display text-xl font-semibold text-(--color-text)">What to expect</h2>
        <ul class="mt-4 space-y-2">
          {service.data.expectedOutcomes.map((item) => (
            <li class="flex items-start gap-2 text-sm text-(--color-text-muted)">
              <Icon
                name="lucide:trending-up"
                class="mt-0.5 size-4 flex-shrink-0 text-(--color-neon)"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>

        <h2 class="mt-10 font-display text-xl font-semibold text-(--color-text)">Limitations</h2>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          Honest scope, not a sales pitch — here's what this service doesn't cover.
        </p>
        <ul class="mt-4 space-y-2">
          {service.data.limitations.map((item) => (
            <li class="flex items-start gap-2 text-sm text-(--color-text-muted)">
              <Icon
                name="lucide:info"
                class="mt-0.5 size-4 flex-shrink-0 text-(--color-text-muted)"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>

        {service.data.faqs.length > 0 && (
          <>
            <h2 class="mt-10 font-display text-xl font-semibold text-(--color-text)">FAQ</h2>
            <div class="mt-4">
              <FAQ items={service.data.faqs} />
            </div>
          </>
        )}
      </div>

      <aside class="glass-card corner-brackets h-fit p-6">
        <h2 class="font-display text-base font-semibold text-(--color-text)">Who it's for</h2>
        <ul class="mt-4 space-y-2">
          {service.data.whoItsFor.map((item) => (
            <li class="text-sm text-(--color-text-muted)">{item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="// PROCESS" title="How this engagement works" />
    <div class="mt-10">
      <ProcessSteps steps={service.data.process} />
    </div>
  </Section>

  <Section>
    <div class="glass-card corner-brackets flex items-start gap-4 p-6 sm:p-8">
      <Icon
        name="lucide:shield-check"
        class="mt-1 size-6 flex-shrink-0 text-(--color-neon)"
        aria-hidden="true"
      />
      <div>
        <h2 class="font-display text-lg font-semibold text-(--color-text)">
          Authorisation &amp; safety
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{authorizationSafety}</p>
      </div>
    </div>
  </Section>

  {relatedCaseStudies.length > 0 && (
    <Section>
      <SectionHeading eyebrow="// RELATED WORK" title="Case studies using this service" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedCaseStudies.map((cs) => (
          <CaseStudyCard
            title={cs.data.title}
            client={cs.data.client}
            industry={cs.data.industry}
            services={cs.data.services}
            href={`/case-studies/${cs.id}/`}
          />
        ))}
      </div>
    </Section>
  )}

  <Section>
    <CTABand
      title="Ready to talk through your scope?"
      text="Book a free consultation. No obligation, no pressure."
    />
  </Section>
</BaseLayout>
