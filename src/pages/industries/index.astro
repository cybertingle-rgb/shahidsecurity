---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTABand from '@/components/CTABand.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Industries"
  description="Cybersecurity services scoped to the specific risks of your industry — SaaS, e-commerce, finance, healthcare, education, manufacturing and SMEs."
  path="/industries/"
  pageType="CollectionPage"
  ogImage="/og/industries.png"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Industries', path: '/industries/' },
      ]}
    />
    <SectionHeading
      as="h1"
      eyebrow="// industries"
      title="Security scoped to your industry"
      intro="Every industry has a different attack surface and a different set of things that can't go wrong. Here's how that maps to what we do."
    />
  </Section>

  <Section class="pt-0">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((ind) => (
        <a href={`/industries/${ind.id}/`} class="glass-card corner-brackets block p-6 transition-colors hover:border-(--color-neon-soft)">
          <Icon name={ind.data.icon} class="size-6 text-(--color-neon)" aria-hidden="true" />
          <h2 class="mt-3 font-display text-lg font-semibold text-(--color-text)">{ind.data.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{ind.data.tagline}</p>
          <span class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-(--color-text-muted)">
            Read more
            <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
          </span>
        </a>
      ))}
    </div>
  </Section>

  <Section>
    <CTABand
      title="Don't see your industry?"
      text="Every engagement is scoped to your systems, not a template. Book a consultation and we'll tell you honestly where you stand."
    />
  </Section>
</BaseLayout>
