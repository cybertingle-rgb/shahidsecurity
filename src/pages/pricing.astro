---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import FAQ from '@/components/FAQ.astro';
import CTABand from '@/components/CTABand.astro';
import { faqSchema } from '@/lib/schema';

// Build-time fetch, same pattern as src/pages/learn/pricing.astro's
// fetch to learn.shahidiqbal.com's /api/public/pricing — the USD
// figures baked into the static HTML (so they're crawlable and need no
// JS) always come from the same admin-managed source of truth a
// visitor's browser later re-fetches for currency conversion, never a
// hardcoded number duplicated here.
const ADMIN_API_BASE = 'https://admin.shahidiqbal.com';

type ConvertedAmount = { currencyCode: string; amount: number; isStale: boolean; usedFallback: boolean };
type ApiPlan = {
  id: string;
  slug: string;
  name: string;
  targetAudience: string | null;
  category: 'assurance' | 'managed_security';
  monthlyPriceUsd: number | null;
  isStartingAtPrice: boolean;
  minContractMonths: number;
  includedFeatures: string[];
  isRecommended: boolean;
  ctaLabel: string | null;
  requiresEnterpriseContact: boolean;
  requires24x7Readiness: boolean;
  purchasable: boolean;
  converted: ConvertedAmount | null;
};
type ApiAddOn = { id: string; slug: string; name: string; description: string | null; startingPriceUsd: number | null; converted: ConvertedAmount | null };
type ApiResponse = {
  plans: ApiPlan[];
  addOns: ApiAddOn[];
  consultation: { feeUsd: number; durationMinutes: number; isRefundable: boolean; refundPolicyText: string | null; converted: ConvertedAmount | null };
  socAvailability: 'disabled' | 'inquiry_only' | 'active';
};

let data: ApiResponse = {
  plans: [],
  addOns: [],
  consultation: { feeUsd: 0, durationMinutes: 45, isRefundable: false, refundPolicyText: null, converted: null },
  socAvailability: 'disabled',
};
try {
  const res = await fetch(`${ADMIN_API_BASE}/api/public/pricing-plans`);
  if (res.ok) data = await res.json();
} catch {
  // Build-time fetch failed (admin app unreachable at build time) —
  // the page still renders with empty plan lists rather than failing
  // the whole site build; the client-side currency script below has
  // the same graceful-degradation behavior at runtime.
}

const assurancePlans = data.plans.filter((p) => p.category === 'assurance');
const managedPlans = data.plans.filter((p) => p.category === 'managed_security');

function formatUsd(amount: number | null): string {
  if (amount === null) return 'Custom Quote';
  return `$${amount.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
}

const BUSINESS_SIZES = [
  { label: 'Startup / Micro Business', desc: 'A handful of people, a handful of systems.' },
  { label: 'Small Business', desc: 'Growing team, growing attack surface.' },
  { label: 'Mid-Sized Business', desc: 'Multiple systems, more to protect.' },
  { label: 'Large Business', desc: 'Complex infrastructure, higher stakes.' },
  { label: 'Enterprise', desc: 'Regulated, multi-location, board-level reporting.' },
];

const SLA_ROWS = [
  { priority: 'P1 — Critical', essential: '1 business day', professional: '4 business hours', advanced: '2 hours' },
  { priority: 'P2 — High', essential: '2 business days', professional: '1 business day', advanced: '4 business hours' },
  { priority: 'P3 — Medium', essential: '3 business days', professional: '2 business days', advanced: '1 business day' },
  { priority: 'P4 — Low', essential: '5 business days', professional: '3 business days', advanced: '2 business days' },
];

const WHATS_INCLUDED = [
  'Onboarding',
  'Asset inventory',
  'Agreed assessments',
  'Monthly security reports',
  'Risk tracking',
  'Remediation recommendations',
  'Client communication',
  'Improvement roadmap',
  'Periodic review',
];

const HOW_IT_WORKS = [
  'Paid discovery consultation',
  'Initial assessment',
  'Contract and scope approval',
  'Onboarding',
  'Monthly security operations',
  'Reporting',
  'Quarterly business review',
];

const FAQ_ITEMS = [
  { q: 'What is monthly cybersecurity support?', a: 'A recurring engagement — vulnerability reviews, assessments, reporting, and advisory — rather than a one-off project, so your security posture is monitored and improved continuously, not checked once and forgotten.' },
  { q: 'Which businesses can subscribe?', a: 'Startups through enterprises, across industries. Every plan lists its target audience and included scope above — company size alone never determines price; your actual infrastructure, risk, and coverage needs do.' },
  { q: 'Do you serve international clients?', a: 'Yes — Shahid Security works with clients across the UAE, Saudi Arabia, Qatar, Oman, the UK, the US, Canada, Australia, Europe, and other markets, remotely.' },
  { q: 'Is penetration testing included?', a: 'Not in the monthly support plans — a full penetration test is a separately scoped add-on (see Specialist Add-On Services above) unless it is explicitly included in your signed Statement of Work.' },
  { q: 'Do you offer 24/7 monitoring?', a: data.socAvailability === 'active' ? 'Yes — Managed Detection and Response is available with internal 24/7 coverage.' : '24/7 managed monitoring is subject to operational availability and enterprise assessment — see the Managed Security Operations section above. Contact our team to discuss your requirements.' },
  { q: 'How is the price calculated?', a: "Plan prices reflect the typical scope described for each tier. Your actual price depends on your real infrastructure, risk profile, asset count, and coverage requirements — which is why every plan's final scope and price is confirmed before you sign anything." },
  { q: 'What happens when additional work is needed?', a: 'Work beyond your plan\'s included hours or scope is billed separately and always requires your written approval first — nothing extra is ever charged without your agreement.' },
  { q: 'Can I upgrade or downgrade?', a: "Yes — talk to your account contact. Changes are confirmed in writing and may affect your contract's price review timing." },
  { q: 'Do you provide incident response?', a: 'Yes — incident response planning and advisory is included from Security Advanced upward, and a standalone Incident Response Engagement is available as an add-on for an active incident.' },
  { q: 'How does onboarding work?', a: 'After your consultation and signed Statement of Work, onboarding covers asset inventory, scope confirmation, and setting up the agreed reporting cadence before monthly operations begin.' },
  { q: 'Do you sign confidentiality agreements?', a: 'Yes — confidentiality is part of the Master Services Agreement every client signs, and a separate NDA is standard practice before any deeper technical discussion.' },
  { q: 'What happens when the contract ends?', a: 'Standard plans renew or end per the cancellation and notice terms in your contract — see Contract Structure above. Nothing renews or cancels silently.' },
  { q: 'Can enterprise services be customized?', a: 'Yes — the Enterprise Security Partnership and Enterprise MDR tiers are built around a customized Statement of Work for your specific environment, not a fixed package.' },
  { q: 'Which currencies can visitors see?', a: 'Prices are shown as an approximate estimate in your local currency (detected automatically, or chosen manually with the currency selector above) alongside the authoritative USD figure.' },
  { q: 'Is the consultation paid?', a: `Yes — the initial consultation has a fixed fee (shown at booking, currently $${data.consultation.feeUsd.toFixed(2)} USD). There is no free consultation.` },
  { q: 'What is the minimum contract period?', a: 'Three months for all standard monthly plans, billed monthly in advance. Enterprise-tier contracts are normally 12 months, with exceptions only when approved by an authorized admin.' },
  { q: "Does local currency display mean I can pay in that currency?", a: 'No — the local-currency figure is an estimate only. The authoritative invoice and actual charge are confirmed in USD (or another currency we explicitly agree to invoice in) before anything is charged.' },
];

const jsonLd = [];
const faq = faqSchema(FAQ_ITEMS.map((f) => ({ question: f.q, answer: f.a })));
if (faq) jsonLd.push(faq);
---

<BaseLayout
  title="Cybersecurity Support Plans & Pricing | Shahid Security"
  description="Explore Shahid Security monthly cybersecurity support plans, vulnerability management, security assessments and managed security services for businesses worldwide."
  path="/pricing/"
  ogImage="/og/pricing.png"
  jsonLd={jsonLd}
  pageType="CollectionPage"
>
  <Section class="pt-12 pb-8">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }]} />
    <SectionHeading
      as="h1"
      eyebrow="// pricing"
      title="Cybersecurity Protection That Grows With Your Business"
      intro="Flexible monthly cybersecurity support for startups, growing businesses and enterprises. Get expert security guidance, vulnerability management, ongoing assessments and managed security services."
    />
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href="/book/" variant="primary">Book a Paid Consultation</Button>
      <Button href="#plans" variant="secondary">Compare Security Plans</Button>
      <label class="ml-auto flex items-center gap-2 font-mono text-xs text-(--color-text-muted)">
        Currency
        <select id="currency-select" class="rounded-md border border-(--color-border-strong) bg-(--color-surface) px-2 py-1.5 text-(--color-text)">
          <option value="auto">Auto-detect</option>
          <option value="USD">USD</option>
          <option value="AED">AED</option>
          <option value="SAR">SAR</option>
          <option value="QAR">QAR</option>
          <option value="OMR">OMR</option>
          <option value="PKR">PKR</option>
          <option value="GBP">GBP</option>
          <option value="EUR">EUR</option>
          <option value="CAD">CAD</option>
          <option value="AUD">AUD</option>
        </select>
      </label>
    </div>
    <p id="currency-note" class="mt-2 font-mono text-xs text-(--color-text-muted)"></p>
  </Section>

  <Section class="pt-0 pb-8" bordered>
    <h2 class="font-display text-xl font-semibold text-(--color-text)">Every business is different</h2>
    <p class="mt-2 max-w-2xl text-sm text-(--color-text-muted)">
      Company size is a starting point, not the answer — your infrastructure, risk, assets, cloud environments, users, endpoints, log volume and
      coverage requirements all shape the right plan and the final price.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-5">
      {BUSINESS_SIZES.map((b) => (
        <div class="rounded-lg border border-(--color-border) bg-(--color-surface) p-4">
          <p class="font-mono text-xs text-(--color-neon)">{b.label}</p>
          <p class="mt-2 text-xs text-(--color-text-muted)">{b.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="plans" class="pt-0">
    <SectionHeading as="h2" eyebrow="// security assurance" title="Monthly Security Assurance Plans" intro="Vulnerability management, assessments, and ongoing advisory — priced in USD, billed monthly." />
    <div class="mt-8 grid gap-6 lg:grid-cols-4">
      {assurancePlans.map((plan) => (
        <div class:list={['glass-card corner-brackets flex flex-col p-6', plan.isRecommended && 'ring-2 ring-(--color-neon)']} data-plan-slug={plan.slug}>
          {plan.isRecommended && <p class="mb-2 font-mono text-xs text-(--color-neon)">★ Recommended</p>}
          <h3 class="font-display text-lg font-semibold text-(--color-text)">{plan.name}</h3>
          {plan.targetAudience && <p class="mt-1 text-xs text-(--color-text-muted)">{plan.targetAudience}</p>}
          <p class="mt-4">
            <span class="font-display text-2xl font-semibold text-(--color-text)" data-price-usd={plan.monthlyPriceUsd ?? ''}>
              {plan.isStartingAtPrice && 'From '}{formatUsd(plan.monthlyPriceUsd)}
            </span>
            {plan.monthlyPriceUsd !== null && <span class="text-sm text-(--color-text-muted)">/month</span>}
          </p>
          <p class="mt-0.5 font-mono text-xs text-(--color-text-muted)" data-price-converted></p>
          <p class="mt-3 text-xs text-(--color-text-muted)">Minimum {plan.minContractMonths}-month contract</p>
          <ul class="mt-4 flex-1 space-y-2 text-sm text-(--color-text-muted)">
            {plan.includedFeatures.map((f) => <li class="flex gap-2"><span class="text-(--color-neon)">•</span>{f}</li>)}
          </ul>
          <Button href={plan.requiresEnterpriseContact ? '/contact/' : '/book/'} variant={plan.isRecommended ? 'primary' : 'secondary'} class="mt-6">
            {plan.ctaLabel || 'Get Started'}
          </Button>
        </div>
      ))}
      {assurancePlans.length === 0 && <p class="text-sm text-(--color-text-muted)">Plans are temporarily unavailable — please check back shortly or contact us directly.</p>}
    </div>
  </Section>

  <Section bordered>
    <SectionHeading
      as="h2"
      eyebrow="// managed security operations"
      title="Managed Security Operations"
      intro="Ongoing monitoring and detection — distinct from the assurance plans above, and priced separately."
    />
    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      {managedPlans.map((plan) => (
        <div class="glass-card corner-brackets flex flex-col p-6" data-plan-slug={plan.slug}>
          <h3 class="font-display text-lg font-semibold text-(--color-text)">{plan.name}</h3>
          <p class="mt-4">
            <span class="font-display text-2xl font-semibold text-(--color-text)" data-price-usd={plan.monthlyPriceUsd ?? ''}>
              {plan.isStartingAtPrice && 'From '}{formatUsd(plan.monthlyPriceUsd)}
            </span>
            {plan.monthlyPriceUsd !== null && <span class="text-sm text-(--color-text-muted)">/month</span>}
          </p>
          <p class="mt-0.5 font-mono text-xs text-(--color-text-muted)" data-price-converted></p>
          <ul class="mt-4 flex-1 space-y-2 text-sm text-(--color-text-muted)">
            {plan.includedFeatures.map((f) => <li class="flex gap-2"><span class="text-(--color-neon)">•</span>{f}</li>)}
          </ul>
          {plan.requires24x7Readiness && !plan.purchasable ? (
            <p class="mt-6 rounded-md border border-(--color-border-strong) bg-(--color-bg) p-3 text-xs text-(--color-text-muted)">
              24/7 managed monitoring is subject to operational availability and enterprise assessment. Contact our team to discuss your
              requirements.
            </p>
          ) : (
            <Button href="/contact/" variant="secondary" class="mt-6">{plan.ctaLabel || 'Request a Proposal'}</Button>
          )}
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl text-xs text-(--color-text-muted)">
      Automated alert generation is never described as 24/7 human security operations here — Managed Detection and Response means real analyst
      coverage, only once that coverage genuinely exists.
    </p>
  </Section>

  <Section bordered>
    <SectionHeading as="h2" eyebrow="// add-ons" title="Specialist Add-On Services" intro="One-off engagements, scoped and priced individually. Final prices depend on scope and complexity." />
    <div class="mt-8 overflow-hidden rounded-lg border border-(--color-border)">
      <table class="w-full text-sm">
        <thead class="bg-(--color-surface) text-left text-(--color-text-muted)">
          <tr><th class="px-4 py-3">Service</th><th class="px-4 py-3">Starting price</th></tr>
        </thead>
        <tbody>
          {data.addOns.map((a) => (
            <tr class="border-t border-(--color-border)" data-addon-slug={a.slug}>
              <td class="px-4 py-3 text-(--color-text)">{a.name}</td>
              <td class="px-4 py-3">
                <span data-price-usd={a.startingPriceUsd ?? ''}>{formatUsd(a.startingPriceUsd)}</span>
                <span class="ml-1 font-mono text-xs text-(--color-text-muted)" data-price-converted></span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-(--color-text-muted)">
      Full penetration testing, major remediation, forensics and emergency incident response are separately scoped unless specifically included in
      a signed Statement of Work.
    </p>
  </Section>

  <Section bordered>
    <SectionHeading as="h2" eyebrow="// consultation" title="Book a Cybersecurity Consultation" intro="Discuss your business's security requirements with Shahid Security. Choose a suitable appointment and tell us about your infrastructure and security concerns." />
    <div class="mt-6 glass-card corner-brackets max-w-xl p-6">
      <p class="text-sm text-(--color-text-muted)">
        Consultation fee: <span class="font-mono text-(--color-text)">${data.consultation.feeUsd.toFixed(2)} USD</span>
        <span class="font-mono text-(--color-text-muted)" data-price-converted data-price-usd={data.consultation.feeUsd}></span>
        &nbsp;·&nbsp; {data.consultation.durationMinutes} minutes
      </p>
      <p class="mt-2 text-xs text-(--color-text-muted)">
        {data.consultation.isRefundable && data.consultation.refundPolicyText ? data.consultation.refundPolicyText : 'This fee is non-refundable.'}
      </p>
      <Button href="/book/" variant="primary" class="mt-4">Book a Paid Consultation</Button>
    </div>
  </Section>

  <Section bordered>
    <SectionHeading as="h2" eyebrow="// support" title="SLA & Support Framework" intro="Initial acknowledgement targets — not guaranteed resolution or containment times." />
    <div class="mt-8 overflow-x-auto rounded-lg border border-(--color-border)">
      <table class="w-full min-w-[480px] text-sm">
        <thead class="bg-(--color-surface) text-left text-(--color-text-muted)">
          <tr><th class="px-4 py-3">Priority</th><th class="px-4 py-3">Essential</th><th class="px-4 py-3">Professional</th><th class="px-4 py-3">Advanced</th></tr>
        </thead>
        <tbody>
          {SLA_ROWS.map((r) => (
            <tr class="border-t border-(--color-border)">
              <td class="px-4 py-3 text-(--color-text)">{r.priority}</td>
              <td class="px-4 py-3 text-(--color-text-muted)">{r.essential}</td>
              <td class="px-4 py-3 text-(--color-text-muted)">{r.professional}</td>
              <td class="px-4 py-3 text-(--color-text-muted)">{r.advanced}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="mt-4 space-y-1 text-xs text-(--color-text-muted)">
      <li><strong class="text-(--color-text)">P1 Critical:</strong> suspected active compromise or critical incident.</li>
      <li><strong class="text-(--color-text)">P2 High:</strong> serious security exposure or high-impact vulnerability.</li>
      <li><strong class="text-(--color-text)">P3 Medium:</strong> medium-risk issue.</li>
      <li><strong class="text-(--color-text)">P4 Low:</strong> general request or advice.</li>
    </ul>
    <p class="mt-3 text-xs text-(--color-text-muted)">
      A separate 24/7 SLA, with its own staffed coverage and escalation targets, only applies once Managed Detection and Response is active — see
      Managed Security Operations above. 24/7 response is never implied for customers on a business-hours plan.
    </p>
  </Section>

  <Section bordered>
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-semibold text-(--color-text)">What's included</h2>
        <ul class="mt-4 space-y-2 text-sm text-(--color-text-muted)">
          {WHATS_INCLUDED.map((i) => <li class="flex gap-2"><span class="text-(--color-neon)">•</span>{i}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl font-semibold text-(--color-text)">How it works</h2>
        <ol class="mt-4 space-y-2 text-sm text-(--color-text-muted)">
          {HOW_IT_WORKS.map((step, i) => <li class="flex gap-2"><span class="font-mono text-(--color-neon)">{i + 1}.</span>{step}</li>)}
        </ol>
      </div>
    </div>
  </Section>

  <Section bordered>
    <SectionHeading as="h2" eyebrow="// methodology" title="How pricing is determined" intro="Plan prices reflect the typical scope described for each tier — your final price is confirmed against your actual environment." />
    <p class="mt-6 max-w-3xl text-sm text-(--color-text-muted)">
      Scope and price depend on: number of employees, number of endpoints, number of websites and applications, public-facing assets, cloud
      infrastructure, office locations, network complexity, log volume, required monitoring hours, compliance obligations, incident response
      requirements, and any specialist skills the engagement needs.
    </p>
  </Section>

  <Section bordered>
    <SectionHeading as="h2" eyebrow="// contracts" title="Contract Structure" intro="Every engagement is backed by a clear written agreement — reviewed by qualified legal counsel for the relevant jurisdiction, never a verbal understanding." />
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-(--color-border) p-5">
        <h3 class="font-mono text-xs text-(--color-neon)">Master Services Agreement (MSA)</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">Legal identities, confidentiality, payment terms, data protection, liability, IP, termination, and dispute resolution.</p>
      </div>
      <div class="rounded-lg border border-(--color-border) p-5">
        <h3 class="font-mono text-xs text-(--color-neon)">Statement of Work (SOW)</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">Exact assets, package and add-ons, included hours, deliverables, exclusions, client responsibilities, authorized testing scope, and start date.</p>
      </div>
      <div class="rounded-lg border border-(--color-border) p-5">
        <h3 class="font-mono text-xs text-(--color-neon)">Service Level Agreement (SLA)</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">Support hours, timezone, severity definitions, acknowledgement targets, escalation, planned maintenance, and third-party dependencies.</p>
      </div>
      <div class="rounded-lg border border-(--color-border) p-5">
        <h3 class="font-mono text-xs text-(--color-neon)">Security Testing Authorization</h3>
        <p class="mt-2 text-sm text-(--color-text-muted)">Written authorization, in-scope and out-of-scope assets, approved methods, testing windows, an emergency stop contact, and data handling.</p>
      </div>
    </div>
    <h3 class="mt-8 font-mono text-xs text-(--color-neon)">Commercial policy</h3>
    <ul class="mt-3 space-y-1.5 text-sm text-(--color-text-muted)">
      <li>Three-month minimum initial term for standard monthly plans; monthly payment in advance.</li>
      <li>Enterprise-tier contracts are normally 12 months, with exceptions only when approved by an authorized admin.</li>
      <li>An onboarding fee (configurable, typically 50–100% of the first monthly fee) and an annual prepayment discount (up to 10%, if approved) may apply.</li>
      <li>Additional hours beyond your plan's included allocation are billed separately; out-of-scope work always requires written approval first.</li>
      <li>Cancellation, renewal, and price-review terms are set out in your contract.</li>
    </ul>
  </Section>

  <Section bordered>
    <h2 class="font-display text-xl font-semibold text-(--color-text)">Frequently Asked Questions</h2>
    <div class="mt-6 max-w-3xl">
      <FAQ items={FAQ_ITEMS.map((f) => ({ q: f.q, a: f.a }))} />
    </div>
  </Section>

  <Section>
    <CTABand
      title="Let's Build a Stronger Security Posture for Your Business."
      text="Book a paid consultation, request an enterprise proposal, or just get in touch — we'll tell you honestly where you stand."
      primaryLabel="Book a Paid Consultation"
      primaryHref="/book/"
    />
  </Section>
</BaseLayout>

<script>
  // Astro's CSP hashing (astro.config.mjs's security.csp) hashes this
  // script's pre-substitution template, not what define:vars actually
  // renders — so a define:vars block here produces a permanent
  // script-src hash mismatch and gets silently blocked by the browser
  // (confirmed via headless-browser testing). ADMIN_API_BASE is a
  // fixed build-time constant, so it doesn't need variable injection —
  // hardcoding it as a literal avoids the bug entirely.
  const ADMIN_API_BASE = 'https://admin.shahidiqbal.com';

  const CURRENCY_STORAGE_KEY = 'shahid-security-currency';
  const select = document.getElementById('currency-select') as HTMLSelectElement | null;
  const note = document.getElementById('currency-note');

  function getStoredCurrency(): string | null {
    try {
      return localStorage.getItem(CURRENCY_STORAGE_KEY);
    } catch {
      return null;
    }
  }
  function storeCurrency(code: string): void {
    try {
      localStorage.setItem(CURRENCY_STORAGE_KEY, code);
    } catch {
      /* localStorage unavailable (private mode, blocked) — selection just won't persist across reloads. */
    }
  }

  async function detectCurrency(): Promise<string> {
    try {
      const localeRegion = (Intl.NumberFormat().resolvedOptions().locale || '').split('-')[1] || '';
      const res = await fetch(`${ADMIN_API_BASE}/api/public/geo-currency${localeRegion ? `?localeRegion=${encodeURIComponent(localeRegion)}` : ''}`);
      const data = await res.json();
      return data.currencyCode || 'USD';
    } catch {
      return 'USD';
    }
  }

  async function applyCurrency(currency: string): Promise<void> {
    if (currency === 'USD') {
      document.querySelectorAll('[data-price-converted]').forEach((el) => (el.textContent = ''));
      if (note) note.textContent = '';
      return;
    }
    try {
      const res = await fetch(`${ADMIN_API_BASE}/api/public/pricing-plans?currency=${encodeURIComponent(currency)}`);
      const data = await res.json();
      if (data.requestedCurrency !== currency) return; // server fell back (e.g. no cached rate) — leave USD-only display

      const byPlan: Record<string, any> = Object.fromEntries((data.plans || []).map((p: any) => [p.slug, p]));
      const byAddOn: Record<string, any> = Object.fromEntries((data.addOns || []).map((a: any) => [a.slug, a]));

      document.querySelectorAll('[data-plan-slug]').forEach((card) => {
        const slug = card.getAttribute('data-plan-slug') ?? '';
        const plan = byPlan[slug];
        const convertedEl = card.querySelector('[data-price-converted]');
        if (plan && plan.converted && !plan.converted.usedFallback && convertedEl) {
          convertedEl.textContent = `≈ ${plan.converted.currencyCode} ${plan.converted.amount.toLocaleString('en-US', { maximumFractionDigits: 0 })}${plan.monthlyPriceUsd !== null ? '/month' : ''} (estimate)`;
        }
      });
      document.querySelectorAll('[data-addon-slug]').forEach((row) => {
        const slug = row.getAttribute('data-addon-slug') ?? '';
        const addOn = byAddOn[slug];
        const convertedEl = row.querySelector('[data-price-converted]');
        if (addOn && addOn.converted && !addOn.converted.usedFallback && convertedEl) {
          convertedEl.textContent = `(≈ ${addOn.converted.currencyCode} ${addOn.converted.amount.toLocaleString('en-US', { maximumFractionDigits: 0 })})`;
        }
      });
      // Consultation fee block isn't inside a [data-plan-slug] card — update it directly.
      const consultEl = document.querySelector('.glass-card [data-price-converted][data-price-usd]');
      if (consultEl && data.consultation?.converted && !data.consultation.converted.usedFallback) {
        consultEl.textContent = ` (≈ ${data.consultation.converted.currencyCode} ${data.consultation.converted.amount.toLocaleString('en-US', { maximumFractionDigits: 2 })})`;
      }

      if (note) note.textContent = 'Local-currency figures are estimates. The authoritative price and actual charge are always in USD.';
    } catch {
      if (note) note.textContent = '';
    }
  }

  (async () => {
    const stored = getStoredCurrency();
    const initial = stored || (await detectCurrency());
    if (select) {
      const hasOption = Boolean(initial) && [...select.options].some((o) => o.value === initial);
      select.value = hasOption ? initial : 'auto';
    }
    if (initial !== 'USD') await applyCurrency(initial);
  })();

  select?.addEventListener('change', async (e) => {
    const value = (e.target as HTMLSelectElement).value;
    if (value === 'auto') {
      try {
        localStorage.removeItem(CURRENCY_STORAGE_KEY);
      } catch {
        /* ignore */
      }
      const detected = await detectCurrency();
      await applyCurrency(detected);
      return;
    }
    storeCurrency(value);
    await applyCurrency(value);
  });
</script>
