---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Preloader from '@/components/Preloader.astro';
import AmbientDoodles from '@/components/AmbientDoodles.astro';
import CursorParticles from '@/components/CursorParticles.astro';
import LunaWidget from '@/components/LunaWidget.astro';
import SocialRail from '@/components/SocialRail.astro';
import LanguageNotice from '@/components/LanguageNotice.astro';
import { site } from '@/lib/site';
import { translations } from '@/lib/i18n';
import { absoluteUrl, pageTitle, twitterHandle } from '@/lib/seo';
import { organizationSchema, websiteSchema, webPageSchema } from '@/lib/schema';
import { getSeoOverride } from '@/lib/seoOverrides';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogImage?: string;
  isHome?: boolean;
  jsonLd?: object[];
  /** Schema.org type for this page's auto-generated WebPage entity. */
  pageType?: 'WebPage' | 'ContactPage' | 'ProfilePage' | 'CollectionPage';
  /** @id of the entity this page is mainly about (e.g. the Person on /about/). */
  mainEntityId?: string;
  /** Open Graph object type — 'article' for blog posts and case studies. */
  ogType?: 'website' | 'article';
  articlePublishedAt?: Date;
  articleModifiedAt?: Date;
  /** Omit the canonical tag — for pages like 404 that have no single real URL. */
  noCanonical?: boolean;
}

const {
  title: propsTitle,
  description: propsDescription,
  path,
  noindex: propsNoindex = false,
  ogImage,
  isHome = false,
  jsonLd = [],
  pageType = 'WebPage',
  mainEntityId,
  ogType = 'website',
  articlePublishedAt,
  articleModifiedAt,
  noCanonical = false,
} = Astro.props;

// An admin-published SEO override for this exact path wins when one
// exists — see src/lib/seoOverrides.ts. Every page with no override
// (every page until one is explicitly published) behaves exactly as
// before this existed.
const seoOverride = getSeoOverride(path);
const title = seoOverride?.title ?? propsTitle;
const description = seoOverride?.description ?? propsDescription;
const noindex = seoOverride?.robotsDirective ? seoOverride.robotsDirective.includes('noindex') : propsNoindex;

const canonical = seoOverride?.canonicalUrl ?? absoluteUrl(path);
const resolvedOgImage = ogImage ? absoluteUrl(ogImage) : absoluteUrl('/brand/og-default.png');
const fullTitle = pageTitle(title, isHome);
const hideSocialRail = path.startsWith('/book');

// Every page automatically gets Organization + WebSite + a WebPage (or
// subtype) entity, correctly linked via stable @id references, without
// each page needing to build this by hand — page-specific extras
// (BreadcrumbList via <Breadcrumbs>, Service, Article, FAQPage, Person)
// are still passed in via `jsonLd`.
const allJsonLd = [
  organizationSchema(),
  websiteSchema(),
  webPageSchema({ path, name: fullTitle, description, type: pageType, mainEntityId }),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#05070a" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && articlePublishedAt && (
      <meta property="article:published_time" content={articlePublishedAt.toISOString()} />
    )}
    {ogType === 'article' && (articleModifiedAt ?? articlePublishedAt) && (
      <meta
        property="article:modified_time"
        content={(articleModifiedAt ?? articlePublishedAt)!.toISOString()}
      />
    )}
    {ogType === 'article' && <meta property="article:author" content={site.founder} />}
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle() && <meta name="twitter:site" content={twitterHandle()} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {allJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    ))}
    <script
      type="application/json"
      id="i18n-dictionary"
      set:html={JSON.stringify(translations)}
    ></script>
  </head>
  <body>
    <Preloader />
    <AmbientDoodles />
    <CursorParticles />
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <Header />
    <LanguageNotice />
    <main id="main-content" class="pt-16">
      <slot />
    </main>
    <Footer />
    {!hideSocialRail && <SocialRail />}
    <LunaWidget />
  </body>
</html>
