---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Practical, plain-English writing on cybersecurity for business owners in Pakistan and beyond."
  path="/blog/"
  ogImage="/og/blog.png"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Blog', path: '/blog/' },
      ]}
    />
    <SectionHeading as="h1" eyebrow="// blog" title="Notes on staying secure" />
  </Section>

  <Section class="pt-0">
    {posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="glass-card corner-brackets block p-6">
            <p class="eyebrow">
              {post.data.publishedAt.toLocaleDateString('en-GB', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </p>
            <h2 class="mt-2 font-display text-lg font-semibold text-(--color-text)">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <div class="glass-card corner-brackets p-10 text-center">
        <p class="eyebrow">// coming soon</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-(--color-text)">
          The first posts are being written.
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-(--color-text-muted)">
          Check back soon for practical, plain-English writing on cybersecurity — or follow us on
          social for updates.
        </p>
      </div>
    )}
  </Section>
</BaseLayout>
