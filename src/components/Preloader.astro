---
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Resolved relative to the project root (process.cwd()) rather than
// import.meta.url — the latter points at wherever Vite relocates this
// component's compiled output during the production build, not its source.
const shieldSvg = readFileSync(path.join(process.cwd(), 'public/brand/shield-icon.svg'), 'utf8');
const shieldPath = shieldSvg.match(/ d="([^"]+)"/)?.[1] ?? '';

// A dense field of shield icons raining top-to-bottom behind the main
// logo — fixed column positions/sizes/timing (not random per-request, so
// SSR output is deterministic) matching CSS rules of the same index below.
const RAIN_ICONS = Array.from({ length: 40 }, (_, i) => i);
---

<div id="preloader" role="presentation" aria-hidden="true">
  <div class="preloader-rain">
    {RAIN_ICONS.map((i) => (
      <svg viewBox="0 0 1024 1024" class="preloader-rain-icon" data-i={i} xmlns="http://www.w3.org/2000/svg">
        <path fill="#4dd4ff" fill-rule="evenodd" d={shieldPath}></path>
      </svg>
    ))}
  </div>
  <div class="preloader-shield-backdrop" aria-hidden="true"></div>
  <div class="preloader-shield-wrap">
    <svg viewBox="0 0 1024 1024" class="preloader-shield" xmlns="http://www.w3.org/2000/svg">
      <path fill="#00bf63" fill-rule="evenodd" d={shieldPath}></path>
    </svg>
  </div>
  <p id="preloader-terminal" class="preloader-terminal font-mono">
    <span class="preloader-prompt">shahid@security:~$</span>
    <span class="preloader-static">SHAHID SECURITY</span>
    <span class="preloader-typed"></span>
    <span class="cursor-blink">█</span>
  </p>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: var(--color-bg);
    transition: opacity 300ms ease;
  }

  #preloader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Full-screen field of small shield icons falling top-to-bottom behind
     the main logo — the "rain" look, in the neon blue accent, at 80%
     layer opacity so it reads as a dense backdrop without competing with
     the big green shield on top of it. */
  .preloader-rain {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0.8;
    pointer-events: none;
  }

  /* Each icon is roughly half the main shield's size (that one is
     min(35vw, 35vh); these range ~13–19vw/vh, centered on half) — square
     via aspect-ratio so only width needs setting per icon below. `left` is
     each icon's horizontal center (translateX(-50%), composed into the
     fall keyframes below since a keyframe's transform replaces rather
     than adds to the element's own). Full-width coverage — the shield
     staying visually in front of anything passing behind it is handled
     by .preloader-shield-backdrop below, not by keeping rain out of that
     area, so the field can be dense edge-to-edge. */
  .preloader-rain-icon {
    position: absolute;
    top: -15%;
    aspect-ratio: 1;
    filter: drop-shadow(0 0 8px rgba(77, 212, 255, 0.75));
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .preloader-rain-icon[data-i='0'] { left: 25.9%; width: min(17.1vw, 17.1vh); animation-duration: 5.39s; animation-delay: -5.13s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='1'] { left: 18.6%; width: min(14.4vw, 14.4vh); animation-duration: 3.52s; animation-delay: -1.51s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='2'] { left: 73.4%; width: min(13.8vw, 13.8vh); animation-duration: 4.86s; animation-delay: -1.44s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='3'] { left: 29.5%; width: min(15.6vw, 15.6vh); animation-duration: 5.93s; animation-delay: -3.73s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='4'] { left: 1.4%; width: min(14.7vw, 14.7vh); animation-duration: 3.51s; animation-delay: -5.25s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='5'] { left: 81.0%; width: min(17.8vw, 17.8vh); animation-duration: 5.89s; animation-delay: -4.52s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='6'] { left: 94.9%; width: min(17.8vw, 17.8vh); animation-duration: 3.9s; animation-delay: -5.13s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='7'] { left: 48.7%; width: min(17.5vw, 17.5vh); animation-duration: 4.97s; animation-delay: -2.69s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='8'] { left: 36.4%; width: min(15.6vw, 15.6vh); animation-duration: 4.1s; animation-delay: -0.88s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='9'] { left: 82.0%; width: min(17.8vw, 17.8vh); animation-duration: 6.45s; animation-delay: -4.21s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='10'] { left: 55.4%; width: min(17.5vw, 17.5vh); animation-duration: 3.47s; animation-delay: -4.13s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='11'] { left: 44.3%; width: min(14.1vw, 14.1vh); animation-duration: 3.71s; animation-delay: -3.23s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='12'] { left: 25.3%; width: min(15.8vw, 15.8vh); animation-duration: 5.12s; animation-delay: -2.5s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='13'] { left: 13.1%; width: min(15.9vw, 15.9vh); animation-duration: 3.82s; animation-delay: -1.57s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='14'] { left: 19.4%; width: min(15.2vw, 15.2vh); animation-duration: 3.26s; animation-delay: -3.98s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='15'] { left: 95.4%; width: min(15.3vw, 15.3vh); animation-duration: 5.52s; animation-delay: -5.61s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='16'] { left: 4.3%; width: min(13.9vw, 13.9vh); animation-duration: 5.82s; animation-delay: -5.06s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='17'] { left: 63.9%; width: min(14vw, 14vh); animation-duration: 4.45s; animation-delay: -5.24s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='18'] { left: 88.6%; width: min(17.8vw, 17.8vh); animation-duration: 3.71s; animation-delay: -5.15s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='19'] { left: 37.5%; width: min(17.3vw, 17.3vh); animation-duration: 3.48s; animation-delay: -5.83s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='20'] { left: 60.4%; width: min(17.3vw, 17.3vh); animation-duration: 3.74s; animation-delay: -3.78s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='21'] { left: 58.1%; width: min(16.5vw, 16.5vh); animation-duration: 4.26s; animation-delay: -4.42s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='22'] { left: 34.1%; width: min(14.8vw, 14.8vh); animation-duration: 3.58s; animation-delay: -4.17s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='23'] { left: 11.2%; width: min(14.4vw, 14.4vh); animation-duration: 3.24s; animation-delay: -3.93s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='24'] { left: 55.6%; width: min(16.3vw, 16.3vh); animation-duration: 3.14s; animation-delay: -2.75s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='25'] { left: 34.3%; width: min(13.6vw, 13.6vh); animation-duration: 3.01s; animation-delay: -5.99s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='26'] { left: 12.2%; width: min(14.8vw, 14.8vh); animation-duration: 3.94s; animation-delay: -3.66s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='27'] { left: 7.7%; width: min(15.8vw, 15.8vh); animation-duration: 4.28s; animation-delay: -5.04s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='28'] { left: 0.6%; width: min(15vw, 15vh); animation-duration: 4.74s; animation-delay: -5.82s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='29'] { left: 51.7%; width: min(15.8vw, 15.8vh); animation-duration: 5.34s; animation-delay: -1.92s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='30'] { left: 3.2%; width: min(16vw, 16vh); animation-duration: 6.19s; animation-delay: -4.48s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='31'] { left: 25.8%; width: min(17.1vw, 17.1vh); animation-duration: 5.97s; animation-delay: -1.7s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='32'] { left: 58.8%; width: min(15.1vw, 15.1vh); animation-duration: 3.85s; animation-delay: -1.87s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='33'] { left: 20.4%; width: min(15.1vw, 15.1vh); animation-duration: 3.13s; animation-delay: -2.51s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='34'] { left: 8.7%; width: min(17.5vw, 17.5vh); animation-duration: 5.1s; animation-delay: -0.22s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='35'] { left: 77.4%; width: min(14.1vw, 14.1vh); animation-duration: 4.68s; animation-delay: -3.42s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='36'] { left: 33.3%; width: min(14.7vw, 14.7vh); animation-duration: 4.52s; animation-delay: -0.99s; animation-name: preloader-rain-fall-a; }
  .preloader-rain-icon[data-i='37'] { left: 86.4%; width: min(13.7vw, 13.7vh); animation-duration: 5.88s; animation-delay: -1.47s; animation-name: preloader-rain-fall-b; }
  .preloader-rain-icon[data-i='38'] { left: 30.3%; width: min(15.3vw, 15.3vh); animation-duration: 3.12s; animation-delay: -0.94s; animation-name: preloader-rain-fall-c; }
  .preloader-rain-icon[data-i='39'] { left: 36.1%; width: min(15.7vw, 15.7vh); animation-duration: 6.07s; animation-delay: -5.94s; animation-name: preloader-rain-fall-a; }

  /* Three fall variants (different sway direction/rotation) so the field
     doesn't look like one icon repeated — each fades in, drifts and
     rotates gently through the fall, and fades out before the loop
     restarts, rather than a flat linear drop. The X component is always
     calc(-50% + sway) — the -50% centers the icon on its `left` position
     (set per-icon above), composed with the sway itself since a CSS
     animation's keyframe transform fully replaces the element's own,
     rather than adding to it. */
  @keyframes preloader-rain-fall-a {
    0% { transform: translate(calc(-50% + 0vw), -20vh) rotate(-4deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(calc(-50% + 2.5vw), 50vh) rotate(4deg); }
    90% { opacity: 1; }
    100% { transform: translate(calc(-50% - 2vw), 120vh) rotate(-6deg); opacity: 0; }
  }
  @keyframes preloader-rain-fall-b {
    0% { transform: translate(calc(-50% + 0vw), -20vh) rotate(5deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(calc(-50% - 3vw), 50vh) rotate(-5deg); }
    90% { opacity: 1; }
    100% { transform: translate(calc(-50% + 2vw), 120vh) rotate(6deg); opacity: 0; }
  }
  @keyframes preloader-rain-fall-c {
    0% { transform: translate(calc(-50% + 0vw), -20vh) rotate(0deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(calc(-50% + 1.5vw), 50vh) rotate(2deg); }
    90% { opacity: 1; }
    100% { transform: translate(calc(-50% - 1.5vw), 120vh) rotate(-2deg); opacity: 0; }
  }

  /* Opaque halo sitting between the rain and the shield, bigger than the
     shield itself. The shield's own circuit pattern is cut from its fill
     with fill-rule="evenodd", so it has genuine transparent holes — a
     rain icon passing directly behind it would otherwise show through
     those holes regardless of z-index. This blocks that, which is what
     lets the rain field stay dense and full-width instead of avoiding
     the shield's footprint. */
  .preloader-shield-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    width: min(46vw, 46vh);
    height: min(46vw, 46vh);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-bg) 0%, var(--color-bg) 55%, transparent 78%);
    pointer-events: none;
  }

  .preloader-shield-wrap {
    position: relative;
    z-index: 1;
    width: min(35vw, 35vh);
    height: min(35vw, 35vh);
    opacity: 0;
    animation: shield-flicker-in 900ms steps(12, end) 80ms forwards;
  }

  .preloader-shield {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 24px rgba(0, 191, 99, 0.7));
    animation: shield-flicker 2.2s linear infinite;
    animation-delay: 900ms;
  }

  .preloader-terminal {
    position: relative;
    z-index: 1;
    font-size: clamp(0.75rem, 2vw, 1.1rem);
    letter-spacing: 0.06em;
    color: var(--color-text);
    opacity: 0;
    text-align: center;
    animation: status-fade-in 400ms ease forwards 500ms;
  }

  .preloader-prompt {
    color: var(--color-text-muted);
    margin-right: 0.6em;
  }

  .preloader-typed {
    display: none;
  }

  .preloader-terminal.is-animated .preloader-static {
    display: none;
  }

  .preloader-terminal.is-animated .preloader-typed {
    display: inline;
  }

  /* Power-on flicker: a jittery, uneven ramp-up rather than a smooth fade,
     like a CRT or a neon sign catching before it holds. */
  @keyframes shield-flicker-in {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 0.8;
    }
    12% {
      opacity: 0.1;
    }
    20% {
      opacity: 0.9;
    }
    26% {
      opacity: 0.2;
    }
    34% {
      opacity: 1;
    }
    40% {
      opacity: 0.3;
    }
    48% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  /* Ongoing hacker-terminal flicker once the shield is "on": irregular
     brightness drops and a hair of jitter, never fully cutting to black. */
  @keyframes shield-flicker {
    0%,
    91%,
    100% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 0 26px rgba(0, 191, 99, 0.85)) brightness(1.05);
    }
    92% {
      opacity: 0.35;
      transform: translateX(-2px);
      filter: drop-shadow(0 0 6px rgba(0, 191, 99, 0.3)) brightness(0.6);
    }
    93% {
      opacity: 1;
      transform: translateX(1px);
    }
    94% {
      opacity: 0.5;
      transform: translateX(0);
      filter: drop-shadow(0 0 10px rgba(0, 191, 99, 0.4)) brightness(0.7);
    }
    95%,
    96.5% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 0 26px rgba(0, 191, 99, 0.85)) brightness(1.05);
    }
    97% {
      opacity: 0.2;
      filter: drop-shadow(0 0 4px rgba(0, 191, 99, 0.25)) brightness(0.5);
    }
    97.5% {
      opacity: 1;
    }
  }

  @keyframes status-fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader-shield-wrap {
      opacity: 1;
      animation: none;
    }
    .preloader-shield {
      animation: none;
      filter: drop-shadow(0 0 24px rgba(0, 191, 99, 0.7));
    }
    .preloader-terminal {
      animation: none;
      opacity: 1;
    }
    .preloader-rain {
      display: none;
    }
  }
</style>

<script>
  const preloader = document.getElementById('preloader');
  const terminal = document.getElementById('preloader-terminal');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function typeBrand() {
    if (!terminal || prefersReducedMotion) return;
    const typedEl = terminal.querySelector<HTMLElement>('.preloader-typed');
    if (!typedEl) return;
    terminal.classList.add('is-animated');
    const text = 'SHAHID SECURITY';
    let i = 0;
    function tick() {
      typedEl!.textContent = text.slice(0, i);
      i++;
      if (i <= text.length) setTimeout(tick, 45);
    }
    tick();
  }
  typeBrand();

  function hidePreloader() {
    if (!preloader) return;
    preloader.classList.add('is-hidden');
    setTimeout(() => preloader.remove(), 350);
  }

  const minDisplay = prefersReducedMotion ? 0 : 900;
  const start = Date.now();

  function finish() {
    const elapsed = Date.now() - start;
    const remaining = Math.max(0, minDisplay - elapsed);
    setTimeout(hidePreloader, remaining);
  }

  if (document.readyState === 'complete') {
    finish();
  } else {
    window.addEventListener('load', finish, { once: true });
  }

  // Safety net: never let this block the page indefinitely.
  setTimeout(hidePreloader, 2500);
</script>
