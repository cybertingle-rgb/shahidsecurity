---
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '@/lib/site';
---

<a
  href={whatsappLink("Hi, I'd like to talk about my security.")}
  target="_blank"
  rel="noopener"
  class="fixed bottom-6 right-6 z-40 flex size-14 items-center justify-center rounded-full bg-(--color-neon) text-(--color-bg) shadow-[0_0_24px_-4px_rgba(26,255,140,0.7)] transition-transform hover:scale-105"
  aria-label="Chat with us on WhatsApp"
>
  <Icon name="lucide:message-circle" class="size-6" aria-hidden="true" />
</a>
