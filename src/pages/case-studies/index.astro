---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import CTABand from '@/components/CTABand.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="Case Studies"
  description="Real, anonymised work: the challenge, what we did, and the measurable result."
  path="/case-studies/"
  noindex={caseStudies.length === 0}
  ogImage="/og/case-studies.png"
  pageType="CollectionPage"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Case Studies', path: '/case-studies/' },
      ]}
    />
    <SectionHeading as="h1" eyebrow="// case studies" title="Real work, real results" />
  </Section>

  <Section class="pt-0">
    {caseStudies.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {caseStudies.map((cs) => (
          <CaseStudyCard
            title={cs.data.title}
            client={cs.data.client}
            industry={cs.data.industry}
            services={cs.data.services}
            href={`/case-studies/${cs.id}/`}
          />
        ))}
      </div>
    ) : (
      <div class="glass-card corner-brackets p-10 text-center">
        <p class="eyebrow">// coming soon</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-(--color-text)">
          Case studies are on the way.
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-(--color-text-muted)">
          We publish case studies only with client permission, and only once real engagements are
          complete. Check back soon — or book a consultation to talk through your own project.
        </p>
      </div>
    )}
  </Section>

  <Section>
    <CTABand
      title="Want results like these for your business?"
      text="Book a free consultation and let's talk through your setup."
    />
  </Section>
</BaseLayout>
