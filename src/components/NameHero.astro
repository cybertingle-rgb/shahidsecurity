---
// Signature name hero: a huge display of "Shahid Iqbal" beside the
// founder's full, uncropped photo on the right (stacked below the name
// on mobile). Reveals via the site-wide data-reveal system
// (CinematicMotion.astro) — no bespoke animation code needed here.
---

<section class="relative overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24">
  <div class="container-page">
    <div
      class="relative grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16"
      data-reveal
    >
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
        <p class="eyebrow">// Hello, I'm</p>
        <h1 class="name-hero-heading mt-4 font-display font-bold uppercase leading-[0.82] tracking-tight text-(--color-text) lg:mt-6">
          <span class="block">Shahid</span>
          <span class="block text-(--color-neon-soft)">Iqbal</span>
        </h1>
        <p class="relative z-10 mt-8 max-w-xl text-lg leading-relaxed text-(--color-text-muted) lg:mt-6">
          Founder of Shahid Security — cybersecurity consultant and ethical hacker, trusted to find
          the gaps before attackers do.
        </p>
      </div>

      <div class="name-hero-photo-wrap mx-auto lg:mx-0 lg:ml-auto">
        <img
          src="/brand/founder-photo.webp"
          alt="Shahid Iqbal, founder of Shahid Security"
          width="480"
          height="598"
          class="name-hero-photo"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .name-hero-heading {
    font-size: clamp(3.25rem, 11vw, 9rem);
  }

  .name-hero-photo-wrap {
    width: clamp(240px, 70vw, 420px);
  }

  .name-hero-photo {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.45));
  }
</style>
