---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CTABand from '@/components/CTABand.astro';
import TrustBar from '@/components/TrustBar.astro';
import HeroBackdrop from '@/components/HeroBackdrop.astro';
import TerminalWindow from '@/components/TerminalWindow.astro';
import ScanDivider from '@/components/ScanDivider.astro';

const homeServiceCards = [
  {
    slug: 'penetration-testing',
    title: 'Penetration Testing',
    description: 'Web, API, mobile and network testing by a human, not just a scanner.',
    icon: 'lucide:terminal-square',
  },
  {
    slug: 'vulnerability-assessment',
    title: 'Vulnerability Assessment & Security Audit',
    description: 'A full review of your systems with a prioritised fix list.',
    icon: 'lucide:search-check',
  },
  {
    slug: 'network-cloud-security',
    title: 'Network & Cloud Security',
    description:
      'Firewalls, secure configuration, access control and hardening for on-prem and cloud.',
    icon: 'lucide:shield-check',
  },
  {
    slug: 'compliance-risk-assessment',
    title: 'Compliance & Risk',
    description: 'Get ready for ISO 27001, GDPR and client security reviews.',
    icon: 'lucide:clipboard-check',
  },
  {
    slug: 'incident-response',
    title: 'Incident Response',
    description: 'Hacked? We help you contain, clean up and recover — then close the door.',
    icon: 'lucide:siren',
  },
];

const processSteps = [
  { title: 'Free consultation', text: '30 minutes to understand your setup and concerns.' },
  {
    title: 'Scoped proposal',
    text: 'Fixed scope, fixed price, clear timeline. NDA signed before any access.',
  },
  {
    title: 'Testing & review',
    text: 'We test safely, with written authorisation, inside agreed boundaries.',
  },
  {
    title: 'Report & fix',
    text: 'Plain-language report, prioritised by risk, and a free re-test after you fix.',
  },
];

const values = [
  { title: 'Authorised & ethical', text: 'We never test anything without written permission.' },
  {
    title: 'Confidential by default',
    text: 'NDA before access; your data never leaves agreed systems.',
  },
  {
    title: 'Plain language',
    text: 'Reports your management can understand, with fixes your developers can apply.',
  },
  { title: 'Honest scope', text: 'We tell you what you need, not what costs the most.' },
];

const trustItems = [
  { icon: 'lucide:reply', text: 'Reply within 24 hours' },
  { icon: 'lucide:file-lock-2', text: 'NDA on request' },
];
---

<BaseLayout
  title="Shahid Security — Penetration Testing & Cybersecurity in Pakistan"
  description="Penetration testing, security audits, network hardening and incident response for businesses in Pakistan and worldwide. Book a free consultation."
  path="/"
  isHome
  ogImage="/og/home.png"
>
  <Section class="relative overflow-hidden pt-20 sm:pt-28">
    <HeroBackdrop />
    <div class="relative grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Protect. Build. Scale. · Cybersecurity from Pakistan</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-(--color-text) sm:text-5xl">
          Find the gaps before attackers do.
          <span class="cursor-blink text-(--color-neon-soft)">█</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-(--color-text-muted)">
          Penetration testing, security audits and hardening for growing businesses — plus secure
          web, software and AI automation built right the first time.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/book/" variant="primary">
            Book a free 30-minute consultation
          </Button>
          <Button href="/services/" variant="secondary">
            See our services
          </Button>
        </div>
        <div class="mt-6">
          <TrustBar
            items={[
              {
                icon: 'lucide:badge-check',
                text: 'CEH-trained · SOC & incident response experience since 2020',
              },
              ...trustItems,
            ]}
          />
        </div>
      </div>
      <TerminalWindow />
    </div>
  </Section>

  <ScanDivider />

  <Section>
    <SectionHeading
      eyebrow="// 01 THE PROBLEM"
      title="Most breaches start with something nobody knew was there."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <div class="glass-card corner-brackets p-6">
        <h3 class="font-display text-lg font-semibold text-(--color-text)">
          You don't know what's exposed.
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">
          Old WordPress plugins, open ports, leaked passwords — most breaches start with something
          nobody knew was there.
        </p>
      </div>
      <div class="glass-card corner-brackets p-6">
        <h3 class="font-display text-lg font-semibold text-(--color-text)">
          Clients are asking about security.
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">
          Questionnaires, ISO 27001, GDPR — and you need clear answers to win the deal.
        </p>
      </div>
      <div class="glass-card corner-brackets p-6">
        <h3 class="font-display text-lg font-semibold text-(--color-text)">
          Nobody owns security.
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">
          Your developers ship features; nobody is checking whether they're safe.
        </p>
      </div>
    </div>
  </Section>

  <ScanDivider />

  <Section>
    <SectionHeading
      eyebrow="> services"
      title="What we do"
      intro="Security when you need it defended. Build when you need it shipped."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {homeServiceCards.map((s) => (
        <ServiceCard
          title={s.title}
          description={s.description}
          href={`/services/${s.slug}/`}
          icon={s.icon}
        />
      ))}
      <ServiceCard
        title="Secure Development & AI Automation"
        description="Websites, software and AI workflows built with security designed in."
        href="/services/#build"
        icon="lucide:sparkles"
      />
    </div>
  </Section>

  <ScanDivider />

  <Section>
    <SectionHeading eyebrow="// 02 HOW WE WORK" title="A straightforward process" />
    <div class="mt-10">
      <ProcessSteps steps={processSteps} />
    </div>
  </Section>

  <ScanDivider />

  <Section>
    <SectionHeading eyebrow="// 03 WHY WORK WITH US" title="Why work with us" />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="glass-card p-6">
          <h3 class="font-display text-base font-semibold text-(--color-text)">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{v.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <CTABand
      title="Not sure where you stand?"
      text="Book a free consultation. We'll tell you honestly what your biggest risk is — even if you don't hire us."
    />
  </Section>
</BaseLayout>
