---
// Smooth-scroll only. This previously also drove a GSAP + ScrollTrigger +
// SplitText reveal system (a hero letter-by-letter write-in, and a
// sitewide scroll-triggered "draw in" effect on every heading/card) —
// removed entirely: that bundle alone was ~52KB gzipped (by far the
// largest single script on the site) and did synchronous DOM-splitting
// work (SplitText) on every heading on every page load, which made the
// site feel slow rather than fast. Lenis alone is ~7KB gzipped and does
// one thing: smooth scrolling.
---

<script>
  import Lenis from 'lenis';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const lenis = new Lenis({
      duration: 1.1,
      smoothWheel: true,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
  }
</script>
