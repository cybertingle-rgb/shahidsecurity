# Where the gateway forwards /admin/* and /learn/* to (docs/consolidation/
# UNIFIED_ARCHITECTURE.md). Defaults to the real, currently-live subdomains
# so this works with no env vars set at all; override only for staging or
# local development against a different target (e.g. a local admin/learn
# dev server).
ADMIN_APP_URL=https://admin.shahidiqbal.com
LEARN_APP_URL=https://learn.shahidiqbal.com
