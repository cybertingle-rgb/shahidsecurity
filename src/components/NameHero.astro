---
// Signature name hero: a huge display of "Shahid Iqbal" beside the
// founder's full, uncropped photo. On mobile the photo is a small
// thumbnail at the top, right of the logo/eyebrow — ahead of the name
// rather than a large block stacked below it; on desktop it's the
// large image in its own column on the right. Both are the same image
// (same URL, so the second request is served from cache, not refetched)
// so there's no real double-load cost from rendering both in the DOM
// and toggling which is visible per breakpoint. No load-in animation —
// renders at full opacity immediately, same as the rest of the site.
---

<section class="relative overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24">
  <div class="container-page">
    <div class="relative grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="flex flex-col items-start text-left">
        <div class="flex w-full items-start justify-between gap-4">
          <div class="flex flex-col items-start">
            <img
              src="/brand/shield-icon.svg"
              alt=""
              width="56"
              height="56"
              class="name-hero-logo"
              loading="eager"
            />
            <p class="eyebrow mt-5">// Hello, I'm</p>
          </div>

          <div class="name-hero-photo-wrap-sm shrink-0 lg:hidden">
            <img
              src="/brand/founder-photo.webp"
              alt="Shahid Iqbal, founder of Shahid Security"
              width="480"
              height="598"
              class="name-hero-photo"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>

        <h1
          class="name-hero-heading mt-4 font-display font-bold uppercase leading-[0.82] tracking-tight text-(--color-text) lg:mt-6"
          aria-label="Shahid Iqbal"
        >
          <span class="block" aria-hidden="true">Shahid</span>
          <span class="block text-(--color-neon-soft)" aria-hidden="true">Iqbal</span>
        </h1>
        <p class="relative z-10 mt-8 max-w-xl text-lg leading-relaxed text-(--color-text-muted) lg:mt-6">
          Founder of Shahid Security — cybersecurity consultant and ethical hacker, trusted to find
          the gaps before attackers do.
        </p>
      </div>

      <div class="name-hero-photo-wrap hidden lg:block lg:ml-auto">
        <img
          src="/brand/founder-photo.webp"
          alt="Shahid Iqbal, founder of Shahid Security"
          width="480"
          height="598"
          class="name-hero-photo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .name-hero-logo {
    width: 2.75rem;
    height: 2.75rem;
  }

  .name-hero-heading {
    font-size: clamp(3.25rem, 11vw, 9rem);
  }

  .name-hero-photo-wrap-sm {
    width: clamp(84px, 24vw, 128px);
  }

  .name-hero-photo-wrap {
    width: clamp(240px, 70vw, 420px);
  }

  .name-hero-photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.45));
  }
</style>
