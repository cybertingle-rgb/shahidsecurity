---
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Resolved relative to the project root (process.cwd()) rather than
// import.meta.url — the latter points at wherever Vite relocates this
// component's compiled output during the production build, not its source.
const shieldSvg = readFileSync(path.join(process.cwd(), 'public/brand/shield-icon.svg'), 'utf8');
const shieldPath = shieldSvg.match(/ d="([^"]+)"/)?.[1] ?? '';

// A dense field of Linux commands raining top-to-bottom behind the main
// logo, each one "typing" itself out as it falls (a width-reveal on the
// text, timed to the same duration as its fall) rather than appearing
// all at once — basic-to-advanced commands, fitting the ethical-hacking
// brand. Fixed per-column left/duration/delay (not random per-request,
// so SSR output is deterministic) reused from the icon-rain field this
// replaced; each is paired with a command and its character count, which
// sets the CSS custom property the typing animation reveals to.
const RAIN_COMMANDS = [
  'ls -la', 'pwd', 'whoami', 'cd /var/log', 'mkdir project', 'cp file.txt backup/',
  'rm -rf tmp/', 'touch notes.txt', 'cat README.md', 'history | tail',
  'chmod 755 scan.sh', 'chown root:root key.pem', 'ps aux | grep nginx', 'df -h',
  'du -sh *', 'grep -r "error" /var/log', 'tar -xzvf archive.tar.gz', 'ssh user@10.0.0.5',
  'scp report.pdf host:/tmp', 'kill -9 1337', 'sudo systemctl restart nginx',
  'iptables -L -n -v', 'nmap -sV -p- 10.0.0.1', 'netstat -tulpn', "awk '{print $1}' access.log",
  'find / -perm -4000 2>/dev/null', 'openssl req -x509 -newkey rsa:4096',
  'journalctl -u sshd --since today', 'tcpdump -i eth0 port 443',
];
const RAIN_POSITIONS = [
  { left: 2.4, dur: 5.39, delay: -5.13 }, { left: 9.1, dur: 3.52, delay: -1.51 },
  { left: 16.4, dur: 4.86, delay: -1.44 }, { left: 23.5, dur: 5.93, delay: -3.73 },
  { left: 30.9, dur: 3.51, delay: -5.25 }, { left: 38.0, dur: 5.89, delay: -4.52 },
  { left: 44.9, dur: 3.9, delay: -5.13 }, { left: 51.7, dur: 4.97, delay: -2.69 },
  { left: 58.4, dur: 4.1, delay: -0.88 }, { left: 64.0, dur: 6.45, delay: -4.21 },
  { left: 70.4, dur: 3.47, delay: -4.13 }, { left: 77.3, dur: 3.71, delay: -3.23 },
  { left: 84.3, dur: 5.12, delay: -2.5 }, { left: 3.1, dur: 3.82, delay: -1.57 },
  { left: 11.4, dur: 3.26, delay: -3.98 }, { left: 18.4, dur: 5.52, delay: -5.61 },
  { left: 25.3, dur: 5.82, delay: -5.06 }, { left: 33.9, dur: 4.45, delay: -5.24 },
  { left: 40.6, dur: 3.71, delay: -5.15 }, { left: 47.5, dur: 3.48, delay: -5.83 },
  { left: 54.4, dur: 3.74, delay: -3.78 }, { left: 61.1, dur: 4.26, delay: -4.42 },
  { left: 68.1, dur: 3.58, delay: -4.17 }, { left: 74.2, dur: 3.24, delay: -3.93 },
  { left: 81.6, dur: 3.14, delay: -2.75 }, { left: 88.3, dur: 3.01, delay: -5.99 },
  { left: 5.6, dur: 3.94, delay: -3.66 }, { left: 94.9, dur: 4.28, delay: -5.04 },
];
const RAIN = RAIN_POSITIONS.map((pos, i) => ({
  ...pos,
  text: RAIN_COMMANDS[i % RAIN_COMMANDS.length],
  chars: RAIN_COMMANDS[i % RAIN_COMMANDS.length].length,
  variant: i % 2 === 0 ? 'a' : 'b',
}));
---

<div id="preloader" role="presentation" aria-hidden="true">
  <div class="preloader-rain">
    {RAIN.map((item, i) => (
      <div
        class={`preloader-rain-cmd preloader-rain-cmd-${item.variant}`}
        data-i={i}
        style={`left:${item.left}%; --dur:${item.dur}s; --delay:${item.delay}s; --chars:${item.chars}ch;`}
      >
        <span class="preloader-rain-cmd-text font-mono">{item.text}</span>
      </div>
    ))}
  </div>
  <div class="preloader-shield-backdrop" aria-hidden="true"></div>
  <div class="preloader-shield-wrap">
    <svg viewBox="0 0 1024 1024" class="preloader-shield" xmlns="http://www.w3.org/2000/svg">
      <path fill="#00bf63" fill-rule="evenodd" d={shieldPath}></path>
    </svg>
  </div>
  <p id="preloader-terminal" class="preloader-terminal font-mono">
    <span class="preloader-prompt">shahid@security:~$</span>
    <span class="preloader-static">SHAHID SECURITY</span>
    <span class="preloader-typed"></span>
    <span class="cursor-blink">█</span>
  </p>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: var(--color-bg);
    transition: opacity 300ms ease;
  }

  #preloader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Full-screen field of Linux commands falling top-to-bottom behind
     the main logo — the "rain" look, in the neon blue accent, at 80%
     layer opacity so it reads as a dense backdrop without competing with
     the big green shield on top of it. */
  .preloader-rain {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0.8;
    pointer-events: none;
  }

  /* Each column is one falling command. `left` (set inline per item in
     the markup, along with --dur/--delay/--chars) is the column's left
     edge — unlike the old icon rain this isn't centered/transformed,
     since text reading left-to-right as it "types" looks right growing
     from a fixed left edge, not from the middle. Two fall variants
     (a/b, picked per item in the markup) give the field slight drift
     variety without the per-icon rotation that read oddly on text.
     Full-width coverage — the shield staying visually in front of
     anything passing behind it is handled by .preloader-shield-backdrop
     below, not by keeping rain out of that area. */
  .preloader-rain-cmd {
    position: absolute;
    top: -8%;
    max-width: 90vw;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-duration: var(--dur);
    animation-delay: var(--delay);
  }

  .preloader-rain-cmd-a {
    animation-name: preloader-rain-fall-a;
  }

  .preloader-rain-cmd-b {
    animation-name: preloader-rain-fall-b;
  }

  /* The command text itself: starts at zero width with hidden overflow,
     then animates open to its full character width (--chars, set inline
     per item) on the same duration/delay as its column's fall — reading
     as the command "typing itself out" as it drops down the screen. */
  .preloader-rain-cmd-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    font-size: clamp(0.6rem, 1.35vw, 0.85rem);
    color: #4dd4ff;
    text-shadow: 0 0 8px rgba(77, 212, 255, 0.75);
    animation: preloader-rain-type var(--dur) linear var(--delay) infinite;
  }

  /* Two fall variants (slightly different horizontal drift) so the field
     doesn't look like one column repeated — each fades in, drifts gently
     downward, and fades out before the loop restarts, rather than a flat
     linear drop. */
  @keyframes preloader-rain-fall-a {
    0% { transform: translate(0vw, -10vh); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(1.5vw, 55vh); }
    90% { opacity: 1; }
    100% { transform: translate(-1vw, 120vh); opacity: 0; }
  }
  @keyframes preloader-rain-fall-b {
    0% { transform: translate(0vw, -10vh); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(-1.5vw, 55vh); }
    90% { opacity: 1; }
    100% { transform: translate(1vw, 120vh); opacity: 0; }
  }

  /* The "typing" reveal — opens to the command's full width early in the
     fall (by 35%) and holds it open for the rest, rather than widening
     across the whole fall, so it reads as a quick type-out rather than a
     slow stretch. */
  @keyframes preloader-rain-type {
    0% { width: 0; }
    35%, 100% { width: var(--chars); }
  }

  /* Opaque halo sitting between the rain and the shield, bigger than the
     shield itself. The shield's own circuit pattern is cut from its fill
     with fill-rule="evenodd", so it has genuine transparent holes — a
     rain icon passing directly behind it would otherwise show through
     those holes regardless of z-index. This blocks that, which is what
     lets the rain field stay dense and full-width instead of avoiding
     the shield's footprint. */
  .preloader-shield-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    width: min(46vw, 46vh);
    height: min(46vw, 46vh);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-bg) 0%, var(--color-bg) 55%, transparent 78%);
    pointer-events: none;
  }

  .preloader-shield-wrap {
    position: relative;
    z-index: 1;
    width: min(35vw, 35vh);
    height: min(35vw, 35vh);
    opacity: 0;
    animation: shield-flicker-in 900ms steps(12, end) 80ms forwards;
  }

  .preloader-shield {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 24px rgba(0, 191, 99, 0.7));
    animation: shield-flicker 2.2s linear infinite;
    animation-delay: 900ms;
  }

  .preloader-terminal {
    position: relative;
    z-index: 1;
    font-size: clamp(0.75rem, 2vw, 1.1rem);
    letter-spacing: 0.06em;
    color: var(--color-text);
    opacity: 0;
    text-align: center;
    animation: status-fade-in 400ms ease forwards 500ms;
  }

  .preloader-prompt {
    color: var(--color-text-muted);
    margin-right: 0.6em;
  }

  .preloader-typed {
    display: none;
  }

  .preloader-terminal.is-animated .preloader-static {
    display: none;
  }

  .preloader-terminal.is-animated .preloader-typed {
    display: inline;
  }

  /* Power-on flicker: a jittery, uneven ramp-up rather than a smooth fade,
     like a CRT or a neon sign catching before it holds. */
  @keyframes shield-flicker-in {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 0.8;
    }
    12% {
      opacity: 0.1;
    }
    20% {
      opacity: 0.9;
    }
    26% {
      opacity: 0.2;
    }
    34% {
      opacity: 1;
    }
    40% {
      opacity: 0.3;
    }
    48% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  /* Ongoing hacker-terminal flicker once the shield is "on": irregular
     brightness drops and a hair of jitter, never fully cutting to black. */
  @keyframes shield-flicker {
    0%,
    91%,
    100% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 0 26px rgba(0, 191, 99, 0.85)) brightness(1.05);
    }
    92% {
      opacity: 0.35;
      transform: translateX(-2px);
      filter: drop-shadow(0 0 6px rgba(0, 191, 99, 0.3)) brightness(0.6);
    }
    93% {
      opacity: 1;
      transform: translateX(1px);
    }
    94% {
      opacity: 0.5;
      transform: translateX(0);
      filter: drop-shadow(0 0 10px rgba(0, 191, 99, 0.4)) brightness(0.7);
    }
    95%,
    96.5% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 0 26px rgba(0, 191, 99, 0.85)) brightness(1.05);
    }
    97% {
      opacity: 0.2;
      filter: drop-shadow(0 0 4px rgba(0, 191, 99, 0.25)) brightness(0.5);
    }
    97.5% {
      opacity: 1;
    }
  }

  @keyframes status-fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader-shield-wrap {
      opacity: 1;
      animation: none;
    }
    .preloader-shield {
      animation: none;
      filter: drop-shadow(0 0 24px rgba(0, 191, 99, 0.7));
    }
    .preloader-terminal {
      animation: none;
      opacity: 1;
    }
    .preloader-rain {
      display: none;
    }
  }
</style>

<script>
  const preloader = document.getElementById('preloader');
  const terminal = document.getElementById('preloader-terminal');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function typeBrand() {
    if (!terminal || prefersReducedMotion) return;
    const typedEl = terminal.querySelector<HTMLElement>('.preloader-typed');
    if (!typedEl) return;
    terminal.classList.add('is-animated');
    const text = 'SHAHID SECURITY';
    let i = 0;
    function tick() {
      typedEl!.textContent = text.slice(0, i);
      i++;
      if (i <= text.length) setTimeout(tick, 45);
    }
    tick();
  }
  typeBrand();

  function hidePreloader() {
    if (!preloader) return;
    preloader.classList.add('is-hidden');
    setTimeout(() => preloader.remove(), 350);
  }

  const minDisplay = prefersReducedMotion ? 0 : 900;
  const start = Date.now();

  function finish() {
    const elapsed = Date.now() - start;
    const remaining = Math.max(0, minDisplay - elapsed);
    setTimeout(hidePreloader, remaining);
  }

  if (document.readyState === 'complete') {
    finish();
  } else {
    window.addEventListener('load', finish, { once: true });
  }

  // Safety net: never let this block the page indefinitely.
  setTimeout(hidePreloader, 2500);
</script>
