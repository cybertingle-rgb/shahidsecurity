---
// Persistent decorative circuit-trace doodles for the empty side gutters
// that exist on any page once the viewport is wide enough that the
// 1200px content column ('--container-content' in global.css) doesn't
// fill it. Rendered once, site-wide, from BaseLayout. Fixed to the
// viewport (not tied to page length or any one section) so it's present
// on every page and every scroll position. Purely cosmetic: aria-hidden,
// pointer-events limited to the glow layer only so it never blocks
// clicks on real content, and it never renders below the width where its
// own footprint would start overlapping the 1200px content column.
---

<div class="ambient-doodles" aria-hidden="true">
  <svg
    class="ambient-doodle ambient-doodle-left"
    viewBox="0 0 220 640"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
  >
    <path
      class="doodle-trace"
      d="M0 40 H90 V140 H40 V240 H120 V320 H60 V420 H140 V520 H80 V600 H180"
      stroke="currentColor"
      stroke-width="2"
    ></path>
    <path
      class="doodle-trace doodle-trace-alt"
      d="M0 300 H50 V180 H150 V80"
      stroke="currentColor"
      stroke-width="2"
    ></path>
    <circle class="doodle-node" cx="90" cy="40" r="5"></circle>
    <circle class="doodle-node" cx="40" cy="240" r="4"></circle>
    <circle class="doodle-node" cx="120" cy="320" r="5"></circle>
    <circle class="doodle-node" cx="140" cy="520" r="4"></circle>
    <circle class="doodle-node" cx="180" cy="600" r="5"></circle>
    <circle class="doodle-node" cx="150" cy="80" r="4"></circle>
    <circle class="doodle-pulse" cx="90" cy="40" r="3"></circle>
  </svg>

  <svg
    class="ambient-doodle ambient-doodle-right"
    viewBox="0 0 220 640"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
  >
    <path
      class="doodle-trace"
      d="M220 60 H130 V160 H180 V260 H100 V340 H160 V440 H80 V540 H140 V620 H40"
      stroke="currentColor"
      stroke-width="2"
    ></path>
    <path
      class="doodle-trace doodle-trace-alt"
      d="M220 320 H170 V200 H70 V100"
      stroke="currentColor"
      stroke-width="2"
    ></path>
    <circle class="doodle-node" cx="130" cy="60" r="5"></circle>
    <circle class="doodle-node" cx="180" cy="260" r="4"></circle>
    <circle class="doodle-node" cx="100" cy="340" r="5"></circle>
    <circle class="doodle-node" cx="80" cy="540" r="4"></circle>
    <circle class="doodle-node" cx="40" cy="620" r="5"></circle>
    <circle class="doodle-node" cx="70" cy="100" r="4"></circle>
    <circle class="doodle-pulse" cx="130" cy="60" r="3"></circle>
  </svg>

  <div class="cursor-ring" data-cursor-ring>
    <span class="cursor-ring-spin"></span>
  </div>
</div>

<style>
  .ambient-doodles {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  /* Visible at every viewport size (mobile included), scaling up with
     the screen. On narrow screens it's a small, low-opacity strip right
     at the edge — enough presence to read as ambient decoration without
     ever covering real content, since there's no real "gutter" on
     mobile the way there is once the page's 1200px content column stops
     filling the viewport. */
  .ambient-doodle {
    display: block;
    position: fixed;
    top: 50%;
    width: 30px;
    height: 87px;
    transform: translateY(-50%);
    color: var(--color-neon);
    opacity: 0.16;
  }

  @media (min-width: 640px) {
    .ambient-doodle {
      width: 55px;
      height: 160px;
      opacity: 0.2;
    }
  }

  @media (min-width: 768px) {
    .ambient-doodle {
      width: 85px;
      height: 247px;
      opacity: 0.24;
    }
  }

  @media (min-width: 1024px) {
    .ambient-doodle {
      width: 115px;
      height: 335px;
      opacity: 0.28;
    }
  }

  /* Only reaches full size once the gutter beyond the 1200px content
     column is wide enough to hold it without overlapping full-width
     content like service/industry card grids. */
  @media (min-width: 1560px) {
    .ambient-doodle {
      width: 140px;
      height: 407px;
      opacity: 0.3;
    }
  }

  .ambient-doodle-left {
    left: 0;
  }

  .ambient-doodle-right {
    right: 0;
  }

  .doodle-trace {
    filter: drop-shadow(0 0 3px currentColor);
  }

  .doodle-trace-alt {
    opacity: 0.6;
  }

  .doodle-node {
    fill: var(--color-neon-soft);
    filter: drop-shadow(0 0 4px currentColor);
    animation: doodle-node-pulse 3s ease-in-out infinite;
  }

  .doodle-node:nth-of-type(2) {
    animation-delay: 0.4s;
  }
  .doodle-node:nth-of-type(3) {
    animation-delay: 0.8s;
  }
  .doodle-node:nth-of-type(4) {
    animation-delay: 1.2s;
  }
  .doodle-node:nth-of-type(5) {
    animation-delay: 1.6s;
  }
  .doodle-node:nth-of-type(6) {
    animation-delay: 2s;
  }

  .doodle-pulse {
    fill: var(--color-neon-soft);
    offset-rotate: 0deg;
    animation: doodle-travel 6s linear infinite;
  }

  .ambient-doodle-left .doodle-pulse {
    offset-path: path('M0 40 H90 V140 H40 V240 H120 V320 H60 V420 H140 V520 H80 V600 H180');
  }

  .ambient-doodle-right .doodle-pulse {
    offset-path: path('M220 60 H130 V160 H180 V260 H100 V340 H160 V440 H80 V540 H140 V620 H40');
  }

  @keyframes doodle-travel {
    from {
      offset-distance: 0%;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    95% {
      opacity: 1;
    }
    to {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes doodle-node-pulse {
    0%,
    100% {
      opacity: 0.5;
      r: 4;
    }
    50% {
      opacity: 1;
      r: 5.5;
    }
  }

  /* A small ring that tracks the pointer and continuously spins in
     place — a "scanning" cursor accent rather than the old wide
     radial glow. Translated to the pointer's exact position on move;
     the spin itself runs independently of pointer movement. */
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
    transform: translate3d(var(--cx, -100px), var(--cy, -100px), 0);
    mix-blend-mode: screen;
  }

  .cursor-ring.is-active {
    opacity: 1;
  }

  .cursor-ring-spin {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      var(--color-neon) 55deg,
      transparent 100deg,
      #ff3b6b 180deg,
      transparent 225deg,
      #3b9bff 305deg,
      transparent 360deg
    );
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
            mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    filter: drop-shadow(0 0 5px var(--color-neon-soft));
    animation: cursor-ring-rotate 1.6s linear infinite;
  }

  @keyframes cursor-ring-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .doodle-node,
    .doodle-pulse {
      animation: none;
    }
    .doodle-pulse {
      opacity: 0;
    }
    .cursor-ring-spin {
      animation: none;
    }
  }
</style>

<script>
  const ring = document.querySelector<HTMLElement>('[data-cursor-ring]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (ring && !prefersReducedMotion) {
    window.addEventListener('pointermove', (e) => {
      ring.style.setProperty('--cx', `${e.clientX}px`);
      ring.style.setProperty('--cy', `${e.clientY}px`);
      ring.classList.add('is-active');
    });
    document.addEventListener('pointerleave', () => {
      ring.classList.remove('is-active');
    });
  }
</script>
