---
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Resolved relative to the project root (process.cwd()) rather than
// import.meta.url — the latter points at wherever Vite relocates this
// component's compiled output during the production build, not its source.
const shieldSvg = readFileSync(path.join(process.cwd(), 'public/brand/shield-icon.svg'), 'utf8');
const shieldPath = shieldSvg.match(/ d="([^"]+)"/)?.[1] ?? '';

// A field of small shield icons raining top-to-bottom behind the main
// logo — fixed column positions/sizes/timing (not random per-request, so
// SSR output is deterministic) matching CSS rules of the same index below.
const RAIN_ICONS = Array.from({ length: 22 }, (_, i) => i);
---

<div id="preloader" role="presentation" aria-hidden="true">
  <div class="preloader-rain">
    {RAIN_ICONS.map((i) => (
      <svg viewBox="0 0 1024 1024" class="preloader-rain-icon" data-i={i} xmlns="http://www.w3.org/2000/svg">
        <path fill="#4dd4ff" fill-rule="evenodd" d={shieldPath}></path>
      </svg>
    ))}
  </div>
  <div class="preloader-shield-wrap">
    <svg viewBox="0 0 1024 1024" class="preloader-shield" xmlns="http://www.w3.org/2000/svg">
      <path fill="#00bf63" fill-rule="evenodd" d={shieldPath}></path>
    </svg>
  </div>
  <p id="preloader-terminal" class="preloader-terminal font-mono">
    <span class="preloader-prompt">shahid@security:~$</span>
    <span class="preloader-static">SHAHID SECURITY</span>
    <span class="preloader-typed"></span>
    <span class="cursor-blink">█</span>
  </p>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: var(--color-bg);
    transition: opacity 300ms ease;
  }

  #preloader.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Full-screen field of small shield icons falling top-to-bottom behind
     the main logo — the "rain" look, in the neon blue accent, at 80%
     layer opacity so it reads as a dense backdrop without competing with
     the big green shield on top of it. */
  .preloader-rain {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0.8;
    pointer-events: none;
  }

  .preloader-rain-icon {
    position: absolute;
    top: -15%;
    filter: drop-shadow(0 0 5px rgba(77, 212, 255, 0.7));
    animation-name: preloader-rain-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .preloader-rain-icon[data-i='0'] { left: 1%; width: 18px; animation-duration: 3.4s; animation-delay: -0.6s; }
  .preloader-rain-icon[data-i='1'] { left: 6%; width: 24px; animation-duration: 4.6s; animation-delay: -2.1s; }
  .preloader-rain-icon[data-i='2'] { left: 11%; width: 15px; animation-duration: 3s; animation-delay: -1.4s; }
  .preloader-rain-icon[data-i='3'] { left: 16%; width: 28px; animation-duration: 5.2s; animation-delay: -3.8s; }
  .preloader-rain-icon[data-i='4'] { left: 21%; width: 20px; animation-duration: 3.8s; animation-delay: -0.2s; }
  .preloader-rain-icon[data-i='5'] { left: 27%; width: 16px; animation-duration: 3.3s; animation-delay: -2.6s; }
  .preloader-rain-icon[data-i='6'] { left: 33%; width: 26px; animation-duration: 4.9s; animation-delay: -1s; }
  .preloader-rain-icon[data-i='7'] { left: 39%; width: 19px; animation-duration: 3.6s; animation-delay: -4.2s; }
  .preloader-rain-icon[data-i='8'] { left: 45%; width: 22px; animation-duration: 4.1s; animation-delay: -1.8s; }
  .preloader-rain-icon[data-i='9'] { left: 51%; width: 15px; animation-duration: 3.1s; animation-delay: -3.3s; }
  .preloader-rain-icon[data-i='10'] { left: 57%; width: 27px; animation-duration: 5s; animation-delay: -0.5s; }
  .preloader-rain-icon[data-i='11'] { left: 63%; width: 18px; animation-duration: 3.5s; animation-delay: -2.9s; }
  .preloader-rain-icon[data-i='12'] { left: 69%; width: 24px; animation-duration: 4.4s; animation-delay: -1.2s; }
  .preloader-rain-icon[data-i='13'] { left: 75%; width: 16px; animation-duration: 3.2s; animation-delay: -4.6s; }
  .preloader-rain-icon[data-i='14'] { left: 80%; width: 29px; animation-duration: 5.4s; animation-delay: -2.3s; }
  .preloader-rain-icon[data-i='15'] { left: 85%; width: 20px; animation-duration: 3.9s; animation-delay: -0.8s; }
  .preloader-rain-icon[data-i='16'] { left: 90%; width: 17px; animation-duration: 3.3s; animation-delay: -3.6s; }
  .preloader-rain-icon[data-i='17'] { left: 95%; width: 25px; animation-duration: 4.7s; animation-delay: -1.6s; }
  .preloader-rain-icon[data-i='18'] { left: 4%; width: 21px; animation-duration: 4s; animation-delay: -5s; }
  .preloader-rain-icon[data-i='19'] { left: 60%; width: 14px; animation-duration: 2.9s; animation-delay: -2s; }
  .preloader-rain-icon[data-i='20'] { left: 48%; width: 30px; animation-duration: 5.5s; animation-delay: -3.1s; }
  .preloader-rain-icon[data-i='21'] { left: 97%; width: 19px; animation-duration: 3.7s; animation-delay: -0.4s; }

  @keyframes preloader-rain-fall {
    from {
      transform: translateY(-20vh);
    }
    to {
      transform: translateY(120vh);
    }
  }

  .preloader-shield-wrap {
    position: relative;
    z-index: 1;
    width: min(35vw, 35vh);
    height: min(35vw, 35vh);
    opacity: 0;
    animation: shield-flicker-in 900ms steps(12, end) 80ms forwards;
  }

  .preloader-shield {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 24px rgba(0, 191, 99, 0.7));
    animation: shield-flicker 2.2s linear infinite;
    animation-delay: 900ms;
  }

  .preloader-terminal {
    position: relative;
    z-index: 1;
    font-size: clamp(0.75rem, 2vw, 1.1rem);
    letter-spacing: 0.06em;
    color: var(--color-neon);
    opacity: 0;
    text-align: center;
    animation: status-fade-in 400ms ease forwards 500ms;
  }

  .preloader-prompt {
    color: var(--color-text-muted);
    margin-right: 0.6em;
  }

  .preloader-typed {
    display: none;
  }

  .preloader-terminal.is-animated .preloader-static {
    display: none;
  }

  .preloader-terminal.is-animated .preloader-typed {
    display: inline;
  }

  /* Power-on flicker: a jittery, uneven ramp-up rather than a smooth fade,
     like a CRT or a neon sign catching before it holds. */
  @keyframes shield-flicker-in {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 0.8;
    }
    12% {
      opacity: 0.1;
    }
    20% {
      opacity: 0.9;
    }
    26% {
      opacity: 0.2;
    }
    34% {
      opacity: 1;
    }
    40% {
      opacity: 0.3;
    }
    48% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

  /* Ongoing hacker-terminal flicker once the shield is "on": irregular
     brightness drops and a hair of jitter, never fully cutting to black. */
  @keyframes shield-flicker {
    0%,
    91%,
    100% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 0 26px rgba(0, 191, 99, 0.85)) brightness(1.05);
    }
    92% {
      opacity: 0.35;
      transform: translateX(-2px);
      filter: drop-shadow(0 0 6px rgba(0, 191, 99, 0.3)) brightness(0.6);
    }
    93% {
      opacity: 1;
      transform: translateX(1px);
    }
    94% {
      opacity: 0.5;
      transform: translateX(0);
      filter: drop-shadow(0 0 10px rgba(0, 191, 99, 0.4)) brightness(0.7);
    }
    95%,
    96.5% {
      opacity: 1;
      transform: translateX(0);
      filter: drop-shadow(0 0 26px rgba(0, 191, 99, 0.85)) brightness(1.05);
    }
    97% {
      opacity: 0.2;
      filter: drop-shadow(0 0 4px rgba(0, 191, 99, 0.25)) brightness(0.5);
    }
    97.5% {
      opacity: 1;
    }
  }

  @keyframes status-fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader-shield-wrap {
      opacity: 1;
      animation: none;
    }
    .preloader-shield {
      animation: none;
      filter: drop-shadow(0 0 24px rgba(0, 191, 99, 0.7));
    }
    .preloader-terminal {
      animation: none;
      opacity: 1;
    }
    .preloader-rain {
      display: none;
    }
  }
</style>

<script>
  const preloader = document.getElementById('preloader');
  const terminal = document.getElementById('preloader-terminal');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function typeBrand() {
    if (!terminal || prefersReducedMotion) return;
    const typedEl = terminal.querySelector<HTMLElement>('.preloader-typed');
    if (!typedEl) return;
    terminal.classList.add('is-animated');
    const text = 'SHAHID SECURITY';
    let i = 0;
    function tick() {
      typedEl!.textContent = text.slice(0, i);
      i++;
      if (i <= text.length) setTimeout(tick, 45);
    }
    tick();
  }
  typeBrand();

  function hidePreloader() {
    if (!preloader) return;
    preloader.classList.add('is-hidden');
    setTimeout(() => preloader.remove(), 350);
  }

  const minDisplay = prefersReducedMotion ? 0 : 900;
  const start = Date.now();

  function finish() {
    const elapsed = Date.now() - start;
    const remaining = Math.max(0, minDisplay - elapsed);
    setTimeout(hidePreloader, remaining);
  }

  if (document.readyState === 'complete') {
    finish();
  } else {
    window.addEventListener('load', finish, { once: true });
  }

  // Safety net: never let this block the page indefinitely.
  setTimeout(hidePreloader, 2500);
</script>
