---
const services = [
  'Penetration Testing',
  'Vulnerability Assessment',
  'Network & Cloud Security',
  'Compliance & Risk',
  'Incident Response (urgent)',
  'Monitoring & Training',
  'Website Development',
  'Software Development',
  'AI Automation',
  'Not sure',
];

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<form id="contact-form" action="/api/contact.php" method="POST" novalidate class="space-y-5">
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1.5 block font-mono text-xs text-(--color-text-muted)">
        Name *
      </label>
      <input
        id="name"
        name="name"
        type="text"
        required
        autocomplete="name"
        aria-describedby="name-error"
        class="w-full rounded-md border border-(--color-border-strong) bg-(--color-surface) px-3 py-2.5 text-(--color-text) focus:border-(--color-neon) focus:outline-none"
      />
      <p id="name-error" class="mt-1 text-xs text-(--color-danger) empty:hidden" role="alert"></p>
    </div>
    <div>
      <label for="email" class="mb-1.5 block font-mono text-xs text-(--color-text-muted)">
        Email *
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        aria-describedby="email-error"
        class="w-full rounded-md border border-(--color-border-strong) bg-(--color-surface) px-3 py-2.5 text-(--color-text) focus:border-(--color-neon) focus:outline-none"
      />
      <p id="email-error" class="mt-1 text-xs text-(--color-danger) empty:hidden" role="alert"></p>
    </div>
    <div>
      <label for="company" class="mb-1.5 block font-mono text-xs text-(--color-text-muted)">
        Company
      </label>
      <input
        id="company"
        name="company"
        type="text"
        autocomplete="organization"
        class="w-full rounded-md border border-(--color-border-strong) bg-(--color-surface) px-3 py-2.5 text-(--color-text) focus:border-(--color-neon) focus:outline-none"
      />
    </div>
    <div>
      <label for="phone" class="mb-1.5 block font-mono text-xs text-(--color-text-muted)">
        Phone / WhatsApp
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        class="w-full rounded-md border border-(--color-border-strong) bg-(--color-surface) px-3 py-2.5 text-(--color-text) focus:border-(--color-neon) focus:outline-none"
      />
    </div>
  </div>

  <div>
    <label for="service" class="mb-1.5 block font-mono text-xs text-(--color-text-muted)">
      Service interested in
    </label>
    <select
      id="service"
      name="service"
      class="w-full rounded-md border border-(--color-border-strong) bg-(--color-surface) px-3 py-2.5 text-(--color-text) focus:border-(--color-neon) focus:outline-none"
    >
      {services.map((s) => (
        <option value={s}>{s}</option>
      ))}
    </select>
  </div>

  <div>
    <label for="message" class="mb-1.5 block font-mono text-xs text-(--color-text-muted)">
      Message *
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      aria-describedby="message-error"
      class="w-full rounded-md border border-(--color-border-strong) bg-(--color-surface) px-3 py-2.5 text-(--color-text) focus:border-(--color-neon) focus:outline-none"
    ></textarea>
    <p id="message-error" class="mt-1 text-xs text-(--color-danger) empty:hidden" role="alert"></p>
  </div>

  <div class="flex items-start gap-2">
    <input
      id="nda"
      name="nda"
      type="checkbox"
      value="yes"
      class="mt-1 size-4 rounded border-(--color-border-strong) bg-(--color-surface) text-(--color-neon) focus:ring-(--color-neon)"
    />
    <label for="nda" class="text-sm text-(--color-text-muted)">
      I'd like an NDA before sharing details
    </label>
  </div>

  <p class="text-xs text-(--color-text-muted)">
    Please don't send passwords or sensitive data through this form.
  </p>

  <!-- Honeypot: hidden from sighted users, left visible to naive bots -->
  <div class="absolute -left-[9999px] top-auto" aria-hidden="true">
    <label for="website">Leave this field empty</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="ts" id="ts" value="" />

  {turnstileSiteKey && (
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
  )}

  <div>
    <button type="submit" id="contact-submit" class="btn btn-primary w-full sm:w-auto">
      Send message
    </button>
    <p id="form-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const tsField = document.getElementById('ts') as HTMLInputElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (tsField) tsField.value = String(Date.now());

  let turnstileLoaded = false;
  function loadTurnstile() {
    if (turnstileLoaded || !document.querySelector('.cf-turnstile')) return;
    turnstileLoaded = true;
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }
  form?.addEventListener('focusin', loadTurnstile, { once: true });
  form?.addEventListener('pointerdown', loadTurnstile, { once: true });

  function clearErrors() {
    form?.querySelectorAll('[role="alert"]').forEach((el) => (el.textContent = ''));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();
    if (!form) return;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }
    if (statusEl) statusEl.textContent = '';

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/contact.php', {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        form.reset();
        window.location.href = '/contact/thanks/';
        return;
      }

      if (data?.fieldErrors) {
        for (const [field, message] of Object.entries(data.fieldErrors)) {
          const el = document.getElementById(`${field}-error`);
          if (el) el.textContent = message as string;
        }
      }
      if (statusEl) {
        statusEl.textContent =
          data?.message || 'Something went wrong. Please try again or WhatsApp us.';
        statusEl.className = 'mt-3 text-sm text-(--color-danger)';
      }
    } catch {
      if (statusEl) {
        statusEl.textContent = 'Network error. Please try again or WhatsApp us.';
        statusEl.className = 'mt-3 text-sm text-(--color-danger)';
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    }
  });
</script>
