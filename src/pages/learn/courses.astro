---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';

const LEARN_API_BASE = 'https://learn.shahidiqbal.com';

type PublicCourse = {
  slug: string;
  title: string;
  shortDescription: string | null;
  level: string;
  durationMinutes: number | null;
  instructorName: string | null;
};

// Same build-time-fetch-with-fallback pattern as /learn/roadmap — the
// catalog is authored in the LMS admin (/admin/courses), never hardcoded
// on this site.
let courses: PublicCourse[] = [];
try {
  const res = await fetch(`${LEARN_API_BASE}/api/public/courses`);
  if (res.ok) {
    const data = await res.json();
    courses = data.courses ?? [];
  }
} catch {
  courses = [];
}
---

<BaseLayout
  title="Course Catalog — Learn with Shahid"
  description="Published cybersecurity courses from Learn with Shahid — structured lessons, quizzes, and progress tracking."
  path="/learn/courses/"
  pageType="CollectionPage"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Learn with Shahid', path: '/learn/' },
        { name: 'Courses', path: '/learn/courses/' },
      ]}
    />
    <SectionHeading
      as="h1"
      eyebrow="// course catalog"
      title="Courses"
      intro="Structured, level-by-level courses — see the full learning path at /learn/roadmap."
    />
  </Section>

  <Section class="pt-0">
    {courses.length === 0 && <p class="text-(--color-text-muted)">No courses are published yet — check back soon.</p>}
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {courses.map((course) => (
        <div class="glass-card p-6">
          <span class="font-mono text-xs uppercase text-(--color-neon)">{course.level}</span>
          <h2 class="mt-2 font-display text-lg font-semibold text-(--color-text)">{course.title}</h2>
          {course.shortDescription && <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{course.shortDescription}</p>}
          <div class="mt-3 flex items-center justify-between text-xs text-(--color-text-muted)">
            {course.instructorName && <span>{course.instructorName}</span>}
            {course.durationMinutes && <span>{Math.round(course.durationMinutes / 60)}h</span>}
          </div>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="https://learn.shahidiqbal.com/register" variant="primary">Create your account</Button>
      <Button href="/learn/pricing/" variant="secondary">See pricing</Button>
    </div>
  </Section>
</BaseLayout>
