---
// A minimal floating social rail for the left edge. Each link sits as a
// small circle at rest and slides open on hover to reveal its label — the
// same "comes out" reveal pattern on every item, not a different
// animation per icon. Icons are plain inline SVGs (official brand glyphs)
// rather than a new icon-package dependency. No phone/WhatsApp entry here
// deliberately — all contact is email-only (info@shahidiqbal.com).
import { site } from '@/lib/site';
---

<nav class="social-rail" aria-label="Social links">
  <span class="social-ring" data-accent="facebook">
    <a href={site.social.facebook} target="_blank" rel="noopener" class="social-pill" data-accent="facebook" aria-label="Facebook">
      <span class="social-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.022 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.875h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.918 8.437-9.94"
          ></path>
        </svg>
      </span>
      <span class="social-label">Facebook</span>
    </a>
  </span>

  <span class="social-ring" data-accent="instagram">
    <a href={site.social.instagram} target="_blank" rel="noopener" class="social-pill" data-accent="instagram" aria-label="Instagram">
      <span class="social-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.92-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.07 4.849-.07M12 0C8.741 0 8.332.014 7.052.072 2.695.272.273 2.69.073 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.2 4.358 2.618 6.78 6.98 6.98C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948s-.014-3.668-.072-4.948C23.73 2.7 21.308.273 16.95.072 15.668.014 15.259 0 12 0m0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881"
          ></path>
        </svg>
      </span>
      <span class="social-label">Instagram</span>
    </a>
  </span>

  <span class="social-ring" data-accent="x">
    <a href={site.social.x} target="_blank" rel="noopener" class="social-pill" data-accent="x" aria-label="X (Twitter)">
      <span class="social-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
      </span>
      <span class="social-label">X</span>
    </a>
  </span>
</nav>

<style>
  .social-rail {
    position: fixed;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  /* A registered custom property lets the browser animate the conic
     gradient's own rotation angle directly, same technique the auth-page
     cards use for their chasing-comet border glow. */
  @property --social-ring-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .social-ring {
    position: relative;
    display: inline-flex;
    border-radius: 999px;
  }

  /* Two comet-heads chasing each other clockwise 180° apart around every
     icon's circle, always on (not just on hover) — but unlike the old
     shared green+blue pair, each platform now gets its own neon ring
     colored from its own brand hue (set per data-accent below), so the
     moving line visually belongs to the icon it surrounds. The padding +
     content-box/exclude mask keeps the gradient confined to a thin ring
     at the edge rather than a solid wedge filling the circle. */
  .social-ring::before,
  .social-ring::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    padding: 2.5px;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    animation: social-ring-spin 4s linear infinite;
    transition:
      inset 220ms ease,
      padding 220ms ease,
      filter 220ms ease,
      opacity 220ms ease;
  }

  .social-ring::after {
    filter: blur(4px);
    opacity: 0.55;
  }

  /* Facebook — brand blue neon. */
  .social-ring[data-accent='facebook']::before {
    background: conic-gradient(
      from var(--social-ring-angle),
      #4da3ff 0deg,
      #4da3ff 30deg,
      transparent 70deg,
      transparent 180deg,
      #1877f2 210deg,
      #1877f2 240deg,
      transparent 280deg,
      transparent 360deg
    );
  }
  .social-ring[data-accent='facebook']::after {
    background: conic-gradient(
      from var(--social-ring-angle),
      transparent 0deg,
      rgba(24, 119, 242, 0.55) 4deg,
      #4da3ff 30deg,
      transparent 70deg,
      transparent 180deg,
      rgba(77, 163, 255, 0.55) 184deg,
      #1877f2 240deg,
      transparent 280deg,
      transparent 360deg
    );
  }

  /* Instagram — the real IG gradient hues (pink + orange) as the two
     comet heads, rather than a single flat brand color. */
  .social-ring[data-accent='instagram']::before {
    background: conic-gradient(
      from var(--social-ring-angle),
      #fcaf45 0deg,
      #fcaf45 30deg,
      transparent 70deg,
      transparent 180deg,
      #e4405f 210deg,
      #e4405f 240deg,
      transparent 280deg,
      transparent 360deg
    );
  }
  .social-ring[data-accent='instagram']::after {
    background: conic-gradient(
      from var(--social-ring-angle),
      transparent 0deg,
      rgba(228, 64, 95, 0.55) 4deg,
      #fcaf45 30deg,
      transparent 70deg,
      transparent 180deg,
      rgba(252, 175, 69, 0.55) 184deg,
      #e4405f 240deg,
      transparent 280deg,
      transparent 360deg
    );
  }

  /* X — bright neon white, matching its dark-background brand mark. */
  .social-ring[data-accent='x']::before {
    background: conic-gradient(
      from var(--social-ring-angle),
      #ffffff 0deg,
      #ffffff 30deg,
      transparent 70deg,
      transparent 180deg,
      #b6d8ff 210deg,
      #b6d8ff 240deg,
      transparent 280deg,
      transparent 360deg
    );
  }
  .social-ring[data-accent='x']::after {
    background: conic-gradient(
      from var(--social-ring-angle),
      transparent 0deg,
      rgba(182, 216, 255, 0.55) 4deg,
      #ffffff 30deg,
      transparent 70deg,
      transparent 180deg,
      rgba(255, 255, 255, 0.55) 184deg,
      #b6d8ff 240deg,
      transparent 280deg,
      transparent 360deg
    );
  }

  @keyframes social-ring-spin {
    to {
      --social-ring-angle: 360deg;
    }
  }

  /* "Expand through the border" on hover — the ring sits further out and
     grows thicker/brighter instead of just sitting still. Kept modest
     (not the huge blur this used to be) specifically so the hovered
     icon's glow doesn't visually bleed into its neighbors a mere 1.6rem
     away and make the whole rail look lit up at once. */
  .social-ring:hover::before {
    inset: -5px;
    padding: 3px;
  }

  .social-ring:hover::after {
    inset: -6px;
    padding: 3.5px;
    filter: blur(6px);
    opacity: 1;
  }

  .social-pill {
    display: flex;
    align-items: center;
    height: 3.5rem;
    width: 3.5rem;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: color-mix(in oklab, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-text-muted);
    transition:
      width 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
  }

  .social-pill:hover {
    width: 11.5rem;
    border-color: var(--color-neon);
    color: var(--color-text);
    box-shadow: 0 0 20px -6px var(--color-neon);
  }

  /* Per-platform brand colors — the icon glyph itself now always shows
     its real brand color (not just on hover), with hover only brightening
     the pill's border/glow to match. CSS custom properties can't be set
     via an inline style="" attribute under this site's strict CSP (no
     unsafe-inline for style-src-attr — only Astro's own hashed <style>
     blocks are allowed), so each platform gets a plain class here instead. */
  .social-pill[data-accent='facebook'] .social-icon svg {
    color: #1877f2;
  }
  .social-pill[data-accent='facebook']:hover {
    border-color: #1877f2;
    box-shadow: 0 0 20px -6px #1877f2;
  }
  .social-pill[data-accent='instagram'] .social-icon svg {
    color: #e4405f;
  }
  .social-pill[data-accent='instagram']:hover {
    border-color: #e4405f;
    box-shadow: 0 0 20px -6px #e4405f;
  }
  .social-pill[data-accent='x'] .social-icon svg {
    color: #eef0f8;
  }
  .social-pill[data-accent='x']:hover {
    border-color: #eef0f8;
    box-shadow: 0 0 20px -6px #eef0f8;
  }

  .social-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
  }

  .social-icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .social-label {
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 500;
    padding-right: 1.1rem;
    opacity: 0;
    transition: opacity 180ms ease 60ms;
  }

  .social-pill:hover .social-label {
    opacity: 1;
  }

  @media (max-width: 900px) {
    /* At phone width there's no empty side gutter to fill and no hover to
       reveal labels on, so the rail moves to a compact horizontal row
       pinned above the safe area at bottom-left — clear of Luna's
       bottom-right button — with smaller, always-tappable icons instead
       of the hover-expanding pills. */
    .social-rail {
      left: 0.75rem;
      top: auto;
      bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
      transform: none;
      flex-direction: row;
      gap: 0.5rem;
    }

    .social-pill,
    .social-pill:hover {
      width: 3.25rem;
      height: 3.25rem;
      /* These sit permanently over page content on mobile (no hover to
         rely on), unlike the desktop rail which floats over empty
         gutter — more opaque so underlying text doesn't bleed through
         the glass. */
      background: color-mix(in oklab, var(--color-bg) 92%, transparent);
    }

    .social-icon {
      width: 3.25rem;
      height: 3.25rem;
    }

    .social-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-pill,
    .social-label {
      transition: none;
    }

    .social-ring::before,
    .social-ring::after {
      animation: none;
    }
  }
</style>
