---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
}

const { href, variant = 'primary', type = 'button', class: className, id } = Astro.props;
const variantClass =
  variant === 'primary' ? 'btn-primary' : variant === 'secondary' ? 'btn-secondary' : 'btn-ghost';
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  id={id}
  class:list={['btn', variantClass, className]}
>
  <slot />
</Tag>
