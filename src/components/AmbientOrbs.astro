---
// Three big, dominant, overlapping circles behind every page — the
// purple-to-blue gradient-mesh backdrop from the glassmorphism reference,
// not small corner glows. Fixed to the viewport, rendered once from
// BaseLayout, same technique and tokens as apps/learn's EduBackground
// orbs (--color-orb-purple / --color-orb-blue) so both sites share one
// background. Purely cosmetic: aria-hidden, pointer-events none.
---

<div class="ambient-orbs" aria-hidden="true">
  <div class="ambient-orb ambient-orb-a"></div>
  <div class="ambient-orb ambient-orb-b"></div>
  <div class="ambient-orb ambient-orb-c"></div>
</div>

<style>
  .ambient-orbs {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    animation: ambient-orb-drift 22s ease-in-out infinite alternate;
  }

  .ambient-orb-a {
    top: -25%;
    left: -15%;
    width: 90vw;
    height: 90vw;
    max-width: 1100px;
    max-height: 1100px;
    background: radial-gradient(circle at 40% 40%, var(--color-orb-purple), transparent 70%);
  }

  .ambient-orb-b {
    bottom: -35%;
    right: -20%;
    width: 100vw;
    height: 100vw;
    max-width: 1300px;
    max-height: 1300px;
    background: radial-gradient(circle at 60% 60%, var(--color-orb-blue), transparent 70%);
    opacity: 0.6;
    animation-duration: 28s;
    animation-delay: -6s;
  }

  .ambient-orb-c {
    top: 20%;
    right: 10%;
    width: 45vw;
    height: 45vw;
    max-width: 520px;
    max-height: 520px;
    background: radial-gradient(circle, var(--color-orb-purple), transparent 70%);
    opacity: 0.3;
    animation-duration: 20s;
    animation-delay: -12s;
  }

  @keyframes ambient-orb-drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(4%, 6%) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-orb {
      animation: none;
    }
  }
</style>
