# Local development — copy to .env and fill in.
# Production values live in the hosting platform's secret store, never
# here. Never commit a real .env file.

# A database entirely separate from apps/learn's LMS database — see
# docs/DATABASE.md.
DATABASE_URL=mysql://admin_dev:admin_dev_password@127.0.0.1:3306/shahid_security_admin_dev
# Full-privilege user for running migrations / apply-grants — see
# src/db/apply-grants.ts.
DATABASE_ADMIN_URL=

# Generate a real random value for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-session-secret-change-me-please-32chars-min

# Encrypts Google OAuth tokens at rest (src/lib/crypto.ts). Required
# before connecting any Google account; the rest of the app works
# without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3200
NODE_ENV=development

# Secret-gates the one-time /api/internal/migrate route (this host has
# no shell access to the deployed build). Generate the same way as
# SESSION_SECRET. Use a different value from apps/learn's MIGRATE_SECRET.
MIGRATE_SECRET=

# One-time seed script only (src/db/seed-super-admin.ts) — not read by
# the running app. Set to real credentials you choose, then unset them.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Google OAuth — optional. Leave unset to disable every "Connect
# Google ___" feature (buttons render disabled with a "not configured"
# note) rather than breaking the rest of the app. Get these from Google
# Cloud Console → APIs & Services → Credentials → OAuth client ID (Web
# application). See docs/GOOGLE_INTEGRATION_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ANALYTICS_PROPERTY_ID=

# Outbound email (review requests, invoice emails) — optional.
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# Payment provider abstraction. 'manual' needs no credentials. A real
# provider only activates once real values are set here.
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_SECRET=
