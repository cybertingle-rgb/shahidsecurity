---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BookingForm from '@/components/BookingForm.astro';
---

<BaseLayout
  title="Book a Consultation"
  description="Pick a time that suits you. We'll discuss your setup, your concerns, and the most sensible next step. A fixed consultation fee applies, shown before you submit."
  path="/book/"
  ogImage="/og/book.png"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Book a Consultation', path: '/book/' },
      ]}
    />
    <SectionHeading
      as="h1"
      eyebrow="// book"
      title="Book a consultation"
      intro="Pick a time that suits you. We'll discuss your setup, your concerns, and recommend the right package — not a sales pitch. A fixed consultation fee applies, shown below before you submit."
    />
    <p class="mt-4 max-w-xl text-sm text-(--color-text-muted)">
      Comparing packages first? See our <a href="/pricing/" class="text-(--color-neon) underline">pricing and plans</a>.
    </p>
  </Section>

  <Section class="pt-0">
    <div class="glass-card corner-brackets max-w-xl p-6 sm:p-8">
      <BookingForm />
    </div>
  </Section>
</BaseLayout>
