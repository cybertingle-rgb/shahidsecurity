---
import { Icon } from 'astro-icon/components';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';

const nav = [
  { label: 'Pricing', href: '/pricing/', i18n: 'nav.pricing' },
  { label: 'Services', href: '/services/', i18n: 'nav.services' },
  { label: 'Industries', href: '/industries/', i18n: 'nav.industries' },
  { label: 'Case Studies', href: '/case-studies/', i18n: 'nav.caseStudies' },
  { label: 'Learn with Shahid', href: '/learn/', i18n: 'nav.learn' },
  { label: 'About', href: '/about/', i18n: 'nav.about' },
  { label: 'Blog', href: '/blog/', i18n: 'nav.blog' },
  { label: 'Contact', href: '/contact/', i18n: 'nav.contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  data-scrolled="false"
>
  <div class="container-page flex h-20 items-center justify-between">
    <a href="/" class="flex items-center" aria-label="Shahid Security home">
      <picture>
        <source srcset="/brand/logo-horizontal-dark-bg-nav.webp" type="image/webp" />
        <img
          src="/brand/logo-horizontal-dark-bg-nav.png"
          alt="Shahid Security"
          width="340"
          height="162"
          class="h-10 w-auto sm:h-14"
        />
      </picture>
    </a>

    <nav id="primary-nav" class="relative hidden lg:flex items-center gap-2.5 rounded-full border border-white/5 bg-white/[0.03] p-2 backdrop-blur-sm" aria-label="Primary">
      <span id="nav-indicator" class="nav-indicator" aria-hidden="true"></span>
      {nav.map((item) => (
        <a
          href={item.href}
          data-i18n={item.i18n}
          data-nav-link
          class:list={[
            'nav-link tap-target relative z-10 rounded-full px-6 py-3.5 font-mono text-base transition-colors duration-200',
            currentPath.startsWith(item.href)
              ? 'text-(--color-text)'
              : 'text-(--color-text-muted) hover:text-(--color-text)',
          ]}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-4">
      <LanguageSwitcher />
      <a href="/book/" data-i18n="nav.book" class="btn btn-primary text-sm px-6 py-3">
        Book a consultation
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden flex items-center justify-center size-11 text-(--color-text)"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Icon name="lucide:menu" class="size-6" aria-hidden="true" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 top-20 bg-(--color-bg)/97 backdrop-blur-2xl border-t border-white/5 hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile menu"
  >
    <nav class="container-page flex flex-col gap-1 py-6" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          data-i18n={item.i18n}
          class="font-mono text-lg py-3 border-b border-(--color-border) text-(--color-text)"
        >
          {item.label}
        </a>
      ))}
      <div class="mt-6 flex items-center justify-between gap-3">
        <span class="font-mono text-xs text-(--color-text-muted)" data-i18n="langSwitcher.label">
          Language
        </span>
        <LanguageSwitcher />
      </div>
      <a href="/book/" data-i18n="nav.book" class="btn btn-primary mt-4 w-full">
        Book a consultation
      </a>
    </nav>
  </div>
</header>

<style>
  #site-header {
    background: transparent;
  }
  #site-header[data-scrolled='true'] {
    background: color-mix(in oklab, var(--color-bg) 55%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-bottom: 1px solid color-mix(in oklab, white 8%, var(--color-border));
    box-shadow:
      0 8px 32px -16px rgba(0, 0, 0, 0.5),
      inset 0 -1px 0 0 color-mix(in oklab, white 4%, transparent);
  }

  /* "Liquid glass" sliding nav indicator — one shared pill, positioned and
     resized via JS (below) instead of each link getting its own static
     active background, so moving between items/hover reads as the pill
     itself flowing to the new position rather than two boxes swapping. */
  .nav-indicator {
    position: absolute;
    top: 0.25rem;
    left: 0;
    height: calc(100% - 0.5rem);
    width: 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-surface) 70%, transparent);
    border: 1px solid color-mix(in oklab, white 14%, transparent);
    backdrop-filter: blur(10px) saturate(160%);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
    box-shadow:
      inset 0 1px 0 0 color-mix(in oklab, white 16%, transparent),
      0 2px 10px -4px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition:
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
      width 480ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms ease-out;
    pointer-events: none;
    will-change: transform, width;
  }
  .nav-indicator.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator {
      transition: opacity 150ms ease-out;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  let focusables: HTMLElement[] = [];
  let lastFocused: HTMLElement | null = null;

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    lastFocused = document.activeElement as HTMLElement;
    focusables = Array.from(menu.querySelectorAll<HTMLElement>('a, button'));
    focusables[0]?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }
    if (e.key === 'Tab' && focusables.length > 0) {
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  // Liquid-glass sliding nav indicator: one shared pill that moves/resizes
  // to whichever link is active or hovered, instead of each link drawing
  // its own static highlight.
  const navEl = document.getElementById('primary-nav');
  const indicator = document.getElementById('nav-indicator');
  if (navEl && indicator) {
    const links = Array.from(navEl.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const activeLink = links.find((a) => a.getAttribute('aria-current') === 'page') ?? null;

    function moveIndicatorTo(el: HTMLElement | null) {
      if (!el || !indicator || !navEl) {
        if (indicator) indicator.classList.remove('is-ready');
        return;
      }
      const navRect = navEl.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      indicator.style.width = `${elRect.width}px`;
      indicator.style.transform = `translateX(${elRect.left - navRect.left}px)`;
      indicator.classList.add('is-ready');
    }

    moveIndicatorTo(activeLink);

    links.forEach((link) => {
      link.addEventListener('mouseenter', () => moveIndicatorTo(link));
      link.addEventListener('focus', () => moveIndicatorTo(link));
    });
    navEl.addEventListener('mouseleave', () => moveIndicatorTo(activeLink));
    navEl.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !navEl.contains(next)) moveIndicatorTo(activeLink);
    });

    window.addEventListener('resize', () => moveIndicatorTo(activeLink));
  }
</script>
