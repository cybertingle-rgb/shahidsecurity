---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTABand from '@/components/CTABand.astro';
import { Icon } from 'astro-icon/components';

const industries = [
  {
    icon: 'lucide:cloud',
    title: 'SaaS & Technology',
    risk: "Customer data at scale, API and multi-tenant isolation risk, and account-takeover attacks — plus enterprise buyers who now expect a SOC 2 or ISO 27001 answer before they'll sign.",
    services: [
      { label: 'Penetration Testing', href: '/services/penetration-testing/' },
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Compliance & Risk', href: '/services/compliance-risk-assessment/' },
      { label: 'Secure Development', href: '/services/custom-software-development/' },
    ],
  },
  {
    icon: 'lucide:shopping-cart',
    title: 'E-Commerce',
    risk: 'Payment data and PCI DSS scope, checkout fraud and bot-driven credential stuffing, and plugin/CMS vulnerabilities that turn a storefront into an easy target — especially during seasonal traffic spikes.',
    services: [
      { label: 'Penetration Testing', href: '/services/penetration-testing/' },
      { label: 'Network & Cloud Security', href: '/services/network-cloud-security/' },
      { label: 'Secure Website Development', href: '/services/secure-website-development/' },
      { label: 'Monitoring & Training', href: '/services/monitoring-training/' },
    ],
  },
  {
    icon: 'lucide:landmark',
    title: 'Finance',
    risk: 'One of the highest-value targets for attackers, with heavy regulatory scrutiny, fraud-detection gaps, and API integrations into banking and payment rails that widen the attack surface.',
    services: [
      { label: 'Penetration Testing', href: '/services/penetration-testing/' },
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Compliance & Risk', href: '/services/compliance-risk-assessment/' },
      { label: 'Incident Response', href: '/services/incident-response/' },
    ],
  },
  {
    icon: 'lucide:heart-pulse',
    title: 'Healthcare',
    risk: 'Patient data confidentiality, legacy and connected medical devices on the network, and ransomware that specifically targets hospitals because downtime is not an option.',
    services: [
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Network & Cloud Security', href: '/services/network-cloud-security/' },
      { label: 'Incident Response', href: '/services/incident-response/' },
    ],
  },
  {
    icon: 'lucide:graduation-cap',
    title: 'Education',
    risk: 'Student PII, campus-wide IoT deployments (parking, ID cards, attendance), and often under-resourced IT teams facing the same threats as much larger organisations.',
    services: [
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Network & Cloud Security', href: '/services/network-cloud-security/' },
      { label: 'Monitoring & Training', href: '/services/monitoring-training/' },
    ],
    caseStudyHref: '/case-studies/iot-smart-campus-threat-analysis/',
  },
  {
    icon: 'lucide:factory',
    title: 'Manufacturing',
    risk: 'OT/ICS systems converging with IT networks, legacy industrial equipment that was never designed to be internet-facing, and ransomware that can halt a production line outright.',
    services: [
      { label: 'Network & Cloud Security', href: '/services/network-cloud-security/' },
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Incident Response', href: '/services/incident-response/' },
    ],
  },
  {
    icon: 'lucide:briefcase-business',
    title: 'SMEs',
    risk: "Limited budget and no dedicated security staff — which makes smaller businesses a prime ransomware target precisely because defenses are weaker, not because there's less to lose.",
    services: [
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Network & Cloud Security', href: '/services/network-cloud-security/' },
      { label: 'Compliance & Risk', href: '/services/compliance-risk-assessment/' },
    ],
  },
];
---

<BaseLayout
  title="Industries"
  description="Cybersecurity services scoped to the specific risks of your industry — SaaS, e-commerce, finance, healthcare, education, manufacturing and SMEs."
  path="/industries/"
  pageType="CollectionPage"
  ogImage="/og/industries.png"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Industries', path: '/industries/' },
      ]}
    />
    <SectionHeading
      as="h1"
      eyebrow="// industries"
      title="Security scoped to your industry"
      intro="Every industry has a different attack surface and a different set of things that can't go wrong. Here's how that maps to what we do."
    />
  </Section>

  <Section class="pt-0">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((ind) => (
        <div class="glass-card corner-brackets p-6">
          <Icon name={ind.icon} class="size-6 text-(--color-neon)" aria-hidden="true" />
          <h2 class="mt-3 font-display text-lg font-semibold text-(--color-text)">{ind.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{ind.risk}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {ind.services.map((s) => (
              <a href={s.href} class="pill pill-low hover:border-(--color-neon-soft)">
                {s.label}
              </a>
            ))}
          </div>
          {ind.caseStudyHref && (
            <a
              href={ind.caseStudyHref}
              class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-(--color-neon-soft)"
            >
              Read the smart-campus case study
              <Icon name="lucide:arrow-right" class="size-3.5" aria-hidden="true" />
            </a>
          )}
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <CTABand
      title="Don't see your industry?"
      text="Every engagement is scoped to your systems, not a template. Book a free consultation and we'll tell you honestly where you stand."
    />
  </Section>
</BaseLayout>
