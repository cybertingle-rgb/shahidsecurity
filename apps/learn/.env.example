# Local development — copy to .env and fill in.
# Production values live in the hosting platform's secret store, never here
# (see docs/LMS_PRE_PHASE_2_REVIEW.md §11).

DATABASE_URL=mysql://learn_dev:learn_dev_password@127.0.0.1:3306/learn_with_shahid_dev

# Generate a real random value for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-session-secret-change-me-please-32chars-min

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# "Continue with Google" — optional. Leave both unset to disable the
# feature entirely (button hides itself). Get these from Google Cloud
# Console → APIs & Services → Credentials → OAuth client ID (Web
# application). Authorized redirect URI must be exactly
# <NEXT_PUBLIC_APP_URL>/api/auth/google/callback (e.g.
# https://learn.shahidiqbal.com/api/auth/google/callback in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
