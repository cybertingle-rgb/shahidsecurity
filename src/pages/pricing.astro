---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import FAQ from '@/components/FAQ.astro';
import CTABand from '@/components/CTABand.astro';
import { Icon } from 'astro-icon/components';
import { faqSchema } from '@/lib/schema';

// Build-time fetch, same pattern as src/pages/learn/pricing.astro's
// fetch to learn.shahidiqbal.com's /api/public/pricing — the USD
// figures baked into the static HTML (so they're crawlable and need no
// JS) always come from the same admin-managed source of truth a
// visitor's browser later re-fetches for currency conversion, never a
// hardcoded number duplicated here.
const ADMIN_API_BASE = 'https://admin.shahidiqbal.com';

type ConvertedAmount = { currencyCode: string; amount: number; isStale: boolean; usedFallback: boolean };
type ApiPlan = {
  id: string;
  slug: string;
  name: string;
  targetAudience: string | null;
  category: 'assurance' | 'managed_security';
  monthlyPriceUsd: number | null;
  isStartingAtPrice: boolean;
  minContractMonths: number;
  includedFeatures: string[];
  includedAssetLimit: number | null;
  includedAnalystHoursPerMonth: number | null;
  isRecommended: boolean;
  ctaLabel: string | null;
  requiresEnterpriseContact: boolean;
  requires24x7Readiness: boolean;
  purchasable: boolean;
  converted: ConvertedAmount | null;
};
type ApiAddOn = { id: string; slug: string; name: string; description: string | null; startingPriceUsd: number | null; converted: ConvertedAmount | null };
type ApiResponse = {
  plans: ApiPlan[];
  addOns: ApiAddOn[];
  consultation: { feeUsd: number; durationMinutes: number; isRefundable: boolean; refundPolicyText: string | null; converted: ConvertedAmount | null };
  socAvailability: 'disabled' | 'inquiry_only' | 'active';
};

let data: ApiResponse = {
  plans: [],
  addOns: [],
  consultation: { feeUsd: 0, durationMinutes: 45, isRefundable: false, refundPolicyText: null, converted: null },
  socAvailability: 'disabled',
};
try {
  const res = await fetch(`${ADMIN_API_BASE}/api/public/pricing-plans`);
  if (res.ok) data = await res.json();
} catch {
  // Build-time fetch failed (admin app unreachable at build time) —
  // the page still renders with empty plan lists rather than failing
  // the whole site build; the client-side currency script below has
  // the same graceful-degradation behavior at runtime.
}

const assurancePlans = data.plans.filter((p) => p.category === 'assurance');
const managedPlans = data.plans.filter((p) => p.category === 'managed_security');

function formatUsd(amount: number | null): string {
  if (amount === null) return 'Custom';
  return `$${amount.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
}

// Compact feature list per card (progressive disclosure into the
// comparison table below, rather than hiding price/CTA behind an
// accordion — the brief explicitly rules out hiding those).
const CARD_FEATURE_LIMIT = 6;

// Qualitative comparison fields the catalogue publishes per plan that
// aren't discrete admin-editable DB columns (unlike price, asset
// limit, analyst hours, contract term, which come live from the API
// above) — matches docs/*.pdf's own "Plan comparison" table content.
const PLAN_COMPARISON_META: Record<string, { vulnerabilityReview: string; webAppReview: string; logReview: string; reporting: string }> = {
  'security-essential': { vulnerabilityReview: 'Monthly', webAppReview: 'Limited', logReview: 'Not standard', reporting: 'Summary' },
  'security-professional': { vulnerabilityReview: 'Biweekly', webAppReview: 'Monthly, limited scope', logReview: 'Up to 3 sources', reporting: 'Monthly' },
  'security-advanced': { vulnerabilityReview: 'Weekly', webAppReview: 'By agreed scope', logReview: 'Agreed SIEM sources', reporting: 'Executive' },
  'enterprise-security-partnership': { vulnerabilityReview: 'Custom', webAppReview: 'Custom', logReview: 'Custom', reporting: 'Board-level options' },
};

const BUSINESS_SIZES = ['Startup / Micro', 'Small Business', 'Mid-Sized', 'Large Business', 'Enterprise'];

const SLA_ROWS = [
  { priority: 'P1 — Critical', essential: '1 business day', professional: '4 business hours', advanced: '2 hours' },
  { priority: 'P2 — High', essential: '2 business days', professional: '1 business day', advanced: '4 business hours' },
  { priority: 'P3 — Medium', essential: '3 business days', professional: '2 business days', advanced: '1 business day' },
  { priority: 'P4 — Low', essential: '5 business days', professional: '3 business days', advanced: '2 business days' },
];

const HOW_IT_WORKS = ['Paid consultation', 'Scope & contract', 'Onboarding', 'Monthly delivery'];

const FAQ_ITEMS = [
  { q: 'What is monthly cybersecurity support?', a: 'A recurring engagement — vulnerability reviews, assessments, reporting, and advisory — rather than a one-off project, so your security posture is monitored and improved continuously, not checked once and forgotten.' },
  { q: 'Which businesses can subscribe?', a: 'Startups through enterprises, across industries. Every plan lists its target audience and included scope above — company size alone never determines price; your actual infrastructure, risk, and coverage needs do.' },
  { q: 'Do you serve international clients?', a: 'Yes — Shahid Security works with clients across the UAE, Saudi Arabia, Qatar, Oman, the UK, the US, Canada, Australia, Europe, and other markets, remotely.' },
  { q: 'Is penetration testing included?', a: 'Not in the monthly support plans — a full penetration test is a separately scoped add-on (see Specialist Services above) unless it is explicitly included in your signed Statement of Work.' },
  { q: 'Do you offer 24/7 monitoring?', a: data.socAvailability === 'active' ? 'Yes — Managed Detection and Response is available with internal 24/7 coverage.' : '24/7 managed monitoring is subject to operational availability and enterprise assessment — see Managed Security Operations above. Contact our team to discuss your requirements.' },
  { q: 'How is the price calculated?', a: "Plan prices reflect the typical scope described for each tier. Your actual price depends on your real infrastructure, risk profile, asset count, and coverage requirements — confirmed before you sign anything." },
  { q: 'What happens when additional work is needed?', a: 'Work beyond your plan\'s included hours or scope is billed separately and always requires your written approval first.' },
  { q: 'Can I upgrade or downgrade?', a: "Yes — talk to your account contact. Changes are confirmed in writing and may affect your contract's price review timing." },
  { q: 'Do you provide incident response?', a: 'Yes — incident response planning and advisory is included from Security Advanced upward, and a standalone Incident Response Engagement is available for an active incident.' },
  { q: 'How does onboarding work?', a: 'After your consultation and signed Statement of Work, onboarding covers asset inventory, scope confirmation, and setting up the agreed reporting cadence before monthly operations begin.' },
  { q: 'Do you sign confidentiality agreements?', a: 'Yes — confidentiality is part of the Master Services Agreement every client signs, and a separate NDA is standard practice before deeper technical discussion.' },
  { q: 'What happens when the contract ends?', a: 'Standard plans renew or end per the cancellation and notice terms in your contract — nothing renews or cancels silently.' },
  { q: 'Can enterprise services be customized?', a: 'Yes — Enterprise Security Partnership is built around a customized Statement of Work for your specific environment, not a fixed package.' },
  { q: 'Which currencies can visitors see?', a: 'Prices are shown as an approximate estimate in your local currency (detected automatically, or chosen manually) alongside the authoritative USD figure.' },
  { q: 'Is the consultation paid?', a: `Yes — the initial consultation has a fixed fee (shown at booking, currently $${data.consultation.feeUsd.toFixed(2)} USD). There is no free consultation.` },
  { q: 'What is the minimum contract period?', a: 'Three months for all standard monthly plans, billed monthly in advance. Enterprise-tier contracts are normally 12 months, with exceptions only when approved.' },
  { q: 'Does local currency display mean I can pay in that currency?', a: 'No — the local-currency figure is an estimate only. The authoritative invoice and charge are confirmed in USD before anything is charged.' },
];

const jsonLd = [];
const faq = faqSchema(FAQ_ITEMS.map((f) => ({ question: f.q, answer: f.a })));
if (faq) jsonLd.push(faq);
---

<BaseLayout
  title="Cybersecurity Support Plans & Pricing | Shahid Security"
  description="Explore Shahid Security monthly cybersecurity support plans, vulnerability management, security assessments and managed security services for businesses worldwide."
  path="/pricing/"
  ogImage="/og/pricing.png"
  jsonLd={jsonLd}
  pageType="CollectionPage"
>
  <!-- Hero — compact, everything essential visible without scrolling -->
  <section class="container-page pt-8 pb-6 sm:pt-10">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }]} />
    <div class="max-w-2xl">
      <p class="eyebrow">// cybersecurity services & plans</p>
      <h1 class="mt-3 font-display text-3xl font-semibold text-(--color-text) sm:text-4xl">
        Cybersecurity Protection That Scales With Your Business
      </h1>
      <p class="mt-3 text-(--color-text-muted)">
        Scalable monthly cybersecurity support for startups, growing businesses and enterprises — remote-first, across international markets.
      </p>
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <Button href="/book/" variant="primary">Book a Paid Consultation</Button>
      <Button href="#plans" variant="secondary">Explore Pricing</Button>
      <div class="ml-auto flex items-center gap-2 font-mono text-xs text-(--color-text-muted)">
        <span class="hidden sm:inline">Currency</span>
        <select id="currency-select" class="rounded-md border border-(--color-border-strong) bg-(--color-surface) px-2 py-1.5 text-(--color-text)">
          <option value="auto">Auto-detect</option>
          <option value="USD">USD</option>
          <option value="AED">AED</option>
          <option value="SAR">SAR</option>
          <option value="QAR">QAR</option>
          <option value="OMR">OMR</option>
          <option value="PKR">PKR</option>
          <option value="GBP">GBP</option>
          <option value="EUR">EUR</option>
          <option value="CAD">CAD</option>
          <option value="AUD">AUD</option>
        </select>
      </div>
    </div>
    <p id="currency-note" class="mt-1.5 font-mono text-[0.7rem] text-(--color-text-muted)"></p>

    <!-- Business-size strip — a starting point, not the price determinant -->
    <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-(--color-border) pt-4">
      <span class="font-mono text-[0.7rem] text-(--color-text-muted)">Built for:</span>
      {BUSINESS_SIZES.map((label) => (
        <span class="rounded-full border border-(--color-border-strong) px-3 py-1 text-xs text-(--color-text-muted)">{label}</span>
      ))}
      <span class="font-mono text-[0.7rem] text-(--color-text-muted)">— infrastructure, risk and coverage shape the actual plan, not headcount alone.</span>
    </div>
  </section>

  <!-- Main pricing packages -->
  <section id="plans" class="container-page py-8">
    <h2 class="font-display text-xl font-semibold text-(--color-text) sm:text-2xl">Monthly Security Assurance Plans</h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-4 [perspective:1600px]">
      {assurancePlans.map((plan) => (
        <div class:list={['pricing-card corner-brackets', plan.isRecommended && 'pricing-card--recommended']} data-plan-slug={plan.slug}>
          <div class="pricing-card__bar" aria-hidden="true">
            <span class="pricing-card__dot"></span>
            <span class="pricing-card__dot"></span>
            <span class="pricing-card__dot"></span>
            <span class="pricing-card__bar-label">// {plan.slug.toUpperCase().replace(/-/g, '_')}</span>
          </div>
          {plan.isRecommended && <p class="pricing-card__badge">Recommended</p>}
          <h3 class="font-display text-lg font-semibold text-(--color-text)">{plan.name}</h3>
          {plan.targetAudience && <p class="mt-1 text-xs text-(--color-text-muted)">{plan.targetAudience}</p>}

          <p class="mt-4 flex items-baseline gap-1">
            {plan.isStartingAtPrice && <span class="text-xs text-(--color-text-muted)">From</span>}
            <span class="font-display text-[1.75rem] font-semibold leading-none text-(--color-text)" data-price-usd={plan.monthlyPriceUsd ?? ''}>
              {formatUsd(plan.monthlyPriceUsd)}
            </span>
            {plan.monthlyPriceUsd !== null && <span class="text-sm text-(--color-text-muted)">/mo</span>}
          </p>
          <p class="mt-0.5 min-h-[1em] font-mono text-xs text-(--color-text-muted)" data-price-converted></p>
          <p class="mt-2 text-xs text-(--color-text-muted)">Min. {plan.minContractMonths}-month contract</p>

          <ul class="mt-4 flex-1 space-y-1.5 text-sm text-(--color-text-muted)">
            {plan.includedFeatures.slice(0, CARD_FEATURE_LIMIT).map((f) => (
              <li class="flex items-start gap-2">
                <Icon name="lucide:check" class="mt-0.5 size-3.5 flex-shrink-0 text-(--color-neon)" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
          {plan.includedFeatures.length > CARD_FEATURE_LIMIT && (
            <a href="#comparison" class="mt-2 inline-block font-mono text-xs text-(--color-neon-soft) hover:underline">
              +{plan.includedFeatures.length - CARD_FEATURE_LIMIT} more — full comparison ↓
            </a>
          )}

          <Button href={plan.requiresEnterpriseContact ? '/contact/' : '/book/'} variant={plan.isRecommended ? 'primary' : 'secondary'} class="mt-5 w-full">
            {plan.ctaLabel || 'Get Started'}
          </Button>
        </div>
      ))}
      {assurancePlans.length === 0 && <p class="text-sm text-(--color-text-muted)">Plans are temporarily unavailable — please check back shortly or contact us directly.</p>}
    </div>
  </section>

  <!-- Pricing comparison -->
  {assurancePlans.length > 0 && (
    <section id="comparison" class="container-page py-8 border-t border-(--color-border)">
      <h2 class="font-display text-xl font-semibold text-(--color-text)">Plan Comparison</h2>
      <div class="mt-5 overflow-x-auto rounded-xl border border-(--color-border)">
        <table class="w-full min-w-[640px] text-sm">
          <thead class="bg-(--color-surface) text-left text-(--color-text-muted)">
            <tr>
              <th class="px-4 py-2.5 font-medium">Feature</th>
              {assurancePlans.map((p) => <th class="px-4 py-2.5 font-medium text-(--color-text)">{p.name.replace('Security ', '')}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-(--color-border)">
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Base price</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{p.isStartingAtPrice && 'From '}{formatUsd(p.monthlyPriceUsd)}/mo</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Asset allowance</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{p.includedAssetLimit ? `Up to ${p.includedAssetLimit}` : 'Custom'}</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Vulnerability review</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{PLAN_COMPARISON_META[p.slug]?.vulnerabilityReview ?? '—'}</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Web application review</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{PLAN_COMPARISON_META[p.slug]?.webAppReview ?? '—'}</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Log / SIEM review</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{PLAN_COMPARISON_META[p.slug]?.logReview ?? '—'}</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Analyst hours / month</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{p.includedAnalystHoursPerMonth ? `Up to ${p.includedAnalystHoursPerMonth}` : 'SOW allocation'}</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Reporting</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{PLAN_COMPARISON_META[p.slug]?.reporting ?? '—'}</td>)}
            </tr>
            <tr>
              <td class="px-4 py-2.5 text-(--color-text-muted)">Contract term</td>
              {assurancePlans.map((p) => <td class="px-4 py-2.5 text-(--color-text)">{p.minContractMonths} months{p.minContractMonths >= 12 ? ' (normally)' : ''}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-2xl text-xs text-(--color-text-muted)">
        Final pricing reflects your actual infrastructure, risk, and coverage needs, confirmed before anything is signed — not employee count alone.
      </p>
    </section>
  )}

  <!-- Managed security operations -->
  <section class="container-page py-8 border-t border-(--color-border)">
    <h2 class="font-display text-xl font-semibold text-(--color-text)">Managed Security Operations</h2>
    <p class="mt-1.5 max-w-2xl text-sm text-(--color-text-muted)">
      Ongoing monitoring and detection — separate from the assurance plans above. Telemetry sources, coverage hours, and escalation procedures are agreed in the contract.
    </p>
    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {managedPlans.map((plan) => (
        <div class="pricing-card corner-brackets" data-plan-slug={plan.slug}>
          <div class="pricing-card__bar" aria-hidden="true">
            <span class="pricing-card__dot"></span>
            <span class="pricing-card__dot"></span>
            <span class="pricing-card__dot"></span>
            <span class="pricing-card__bar-label">// {plan.slug.toUpperCase().replace(/-/g, '_')}</span>
          </div>
          <h3 class="font-display text-lg font-semibold text-(--color-text)">{plan.name}</h3>
          <p class="mt-4 flex items-baseline gap-1">
            {plan.isStartingAtPrice && <span class="text-xs text-(--color-text-muted)">From</span>}
            <span class="font-display text-[1.75rem] font-semibold leading-none text-(--color-text)" data-price-usd={plan.monthlyPriceUsd ?? ''}>
              {formatUsd(plan.monthlyPriceUsd)}
            </span>
            {plan.monthlyPriceUsd !== null && <span class="text-sm text-(--color-text-muted)">/mo</span>}
          </p>
          <p class="mt-0.5 min-h-[1em] font-mono text-xs text-(--color-text-muted)" data-price-converted></p>
          <ul class="mt-4 flex-1 space-y-1.5 text-sm text-(--color-text-muted)">
            {plan.includedFeatures.slice(0, CARD_FEATURE_LIMIT).map((f) => (
              <li class="flex items-start gap-2">
                <Icon name="lucide:check" class="mt-0.5 size-3.5 flex-shrink-0 text-(--color-neon)" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
          {plan.requires24x7Readiness && !plan.purchasable ? (
            <p class="mt-5 rounded-md border border-(--color-border-strong) bg-(--color-bg) p-3 text-xs text-(--color-text-muted)">
              Subject to operational availability and enterprise assessment. Contact our team to discuss your requirements.
            </p>
          ) : (
            <Button href="/contact/" variant="secondary" class="mt-5 w-full">{plan.ctaLabel || 'Request a Proposal'}</Button>
          )}
        </div>
      ))}
    </div>
    <p class="mt-4 max-w-2xl text-xs text-(--color-text-muted)">
      Automated alert generation is never described as 24/7 human security operations here, and no plan guarantees detection or prevention of every attack — Managed Detection and Response means real analyst coverage, only once that coverage genuinely exists and is contractually agreed.
    </p>
  </section>

  <!-- Specialist services -->
  <section class="container-page py-8 border-t border-(--color-border)">
    <h2 class="font-display text-xl font-semibold text-(--color-text)">Specialist Cybersecurity Services</h2>
    <p class="mt-1.5 max-w-2xl text-sm text-(--color-text-muted)">
      One-off, separately scoped engagements — not automatically included in monthly plans unless stated in a signed scope.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {data.addOns.map((a) => (
        <div class="addon-card" data-addon-slug={a.slug}>
          <h3 class="font-display text-sm font-semibold text-(--color-text)">{a.name}</h3>
          {a.description && <p class="mt-1.5 text-xs leading-relaxed text-(--color-text-muted)">{a.description}</p>}
          <div class="mt-3 flex items-center justify-between gap-2">
            <p class="font-mono text-sm text-(--color-text)">
              <span data-price-usd={a.startingPriceUsd ?? ''}>{a.startingPriceUsd !== null ? `From ${formatUsd(a.startingPriceUsd)}` : 'Custom Quote'}</span>
              <span class="ml-1 text-xs text-(--color-text-muted)" data-price-converted></span>
            </p>
            <a href="/contact/" class="font-mono text-xs text-(--color-neon-soft) hover:underline">Enquire →</a>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-(--color-text-muted)">
      Full penetration testing, major remediation, forensics and emergency incident response are separately scoped unless specifically included in a signed Statement of Work.
    </p>
  </section>

  <!-- Consultation & contract -->
  <section class="container-page py-8 border-t border-(--color-border)">
    <div class="grid gap-6 lg:grid-cols-5">
      <div class="pricing-card lg:col-span-2">
        <h2 class="font-display text-lg font-semibold text-(--color-text)">Book a Paid Consultation</h2>
        <p class="mt-2 text-sm text-(--color-text-muted)">Discuss your infrastructure and security concerns — we'll recommend the right package.</p>
        <p class="mt-4 text-sm text-(--color-text-muted)">
          Fee: <span class="font-mono text-(--color-text)">${data.consultation.feeUsd.toFixed(2)} USD</span>
          <span class="font-mono text-(--color-text-muted)" data-price-converted data-price-usd={data.consultation.feeUsd}></span>
          &nbsp;·&nbsp;{data.consultation.durationMinutes} min
        </p>
        <p class="mt-1.5 text-xs text-(--color-text-muted)">
          {data.consultation.isRefundable && data.consultation.refundPolicyText ? data.consultation.refundPolicyText : 'This fee is non-refundable.'}
        </p>
        <Button href="/book/" variant="primary" class="mt-4 w-full">Book Your Paid Consultation</Button>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-display text-lg font-semibold text-(--color-text)">Contract & Commercial Terms</h2>
        <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm text-(--color-text-muted) sm:grid-cols-2">
          <li class="flex gap-2"><span class="text-(--color-neon)">•</span>3-month minimum initial term for standard plans</li>
          <li class="flex gap-2"><span class="text-(--color-neon)">•</span>Monthly billing, in advance</li>
          <li class="flex gap-2"><span class="text-(--color-neon)">•</span>Enterprise terms normally 12 months</li>
          <li class="flex gap-2"><span class="text-(--color-neon)">•</span>Onboarding fee may apply (complexity-based)</li>
          <li class="flex gap-2"><span class="text-(--color-neon)">•</span>Out-of-scope work requires written approval</li>
          <li class="flex gap-2"><span class="text-(--color-neon)">•</span>Taxes and applicable fees are additional</li>
          <li class="flex gap-2 sm:col-span-2"><span class="text-(--color-neon)">•</span>Governed by a signed MSA, SOW, and SLA — reviewed by qualified legal counsel for your jurisdiction</li>
        </ul>

        <h3 class="mt-5 font-mono text-xs text-(--color-text-muted)">How it works</h3>
        <ol class="mt-2 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-(--color-text-muted)">
          {HOW_IT_WORKS.map((step, i) => <li class="flex items-center gap-1.5"><span class="font-mono text-(--color-neon)">{i + 1}.</span>{step}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- SLA -->
  <section class="container-page py-8 border-t border-(--color-border)">
    <h2 class="font-display text-xl font-semibold text-(--color-text)">SLA & Support</h2>
    <p class="mt-1.5 text-sm text-(--color-text-muted)">Initial acknowledgement targets — not guaranteed resolution or containment times.</p>
    <div class="mt-5 overflow-x-auto rounded-xl border border-(--color-border)">
      <table class="w-full min-w-[480px] text-sm">
        <thead class="bg-(--color-surface) text-left text-(--color-text-muted)">
          <tr><th class="px-4 py-2.5 font-medium">Priority</th><th class="px-4 py-2.5 font-medium">Essential</th><th class="px-4 py-2.5 font-medium">Professional</th><th class="px-4 py-2.5 font-medium">Advanced</th></tr>
        </thead>
        <tbody class="divide-y divide-(--color-border)">
          {SLA_ROWS.map((r) => (
            <tr>
              <td class="px-4 py-2.5 text-(--color-text)">{r.priority}</td>
              <td class="px-4 py-2.5 text-(--color-text-muted)">{r.essential}</td>
              <td class="px-4 py-2.5 text-(--color-text-muted)">{r.professional}</td>
              <td class="px-4 py-2.5 text-(--color-text-muted)">{r.advanced}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-(--color-text-muted)">
      A separate 24/7 SLA only applies once Managed Detection and Response is active. 24/7 response is never implied for customers on a business-hours plan.
    </p>
  </section>

  <!-- FAQ -->
  <section class="container-page py-8 border-t border-(--color-border)">
    <h2 class="font-display text-xl font-semibold text-(--color-text)">Frequently Asked Questions</h2>
    <div class="mt-4 max-w-3xl">
      <FAQ items={FAQ_ITEMS.map((f) => ({ q: f.q, a: f.a }))} />
    </div>
  </section>

  <section class="container-page pb-16 pt-4">
    <CTABand
      title="Let's Build a Stronger Security Posture for Your Business."
      text="Book a paid consultation, request an enterprise proposal, or just get in touch — we'll tell you honestly where you stand."
      primaryLabel="Book a Paid Consultation"
      primaryHref="/book/"
    />
  </section>
</BaseLayout>

<style>
  /* Extra side breathing room on wide viewports — .container-page's
     site-wide 1.5rem side padding (global.css) reads as edge-to-edge
     once the container hits its own 1440px max-width, which is exactly
     this page's content width on a standard desktop screen. Scoped to
     this page's own sections only (Astro scopes <style> by default),
     not a sitewide .container-page change. */
  section.container-page {
    padding-inline: 1.25rem;
  }

  @media (min-width: 1024px) {
    section.container-page {
      padding-inline: 3rem;
    }
  }

  /* 3D glassmorphism pricing cards — builds on the site's existing
     .glass-card material (backdrop blur, frosted surface, inset
     highlight) rather than inventing a new one, with the extra depth/
     lift/recommended treatment this page specifically asked for.
     Scoped to this page only — the shared .glass-card class and every
     other page using it is untouched. */
  .pricing-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1.25rem;
    /* .corner-brackets (global.css) positions its ⌜⌟ pseudo-elements
       absolutely within the nearest positioned ancestor — this is it.
       The HUD/terminal-frame touch from the reference design, reusing
       the same accent every other bracketed panel on the site already
       uses, rather than a one-off new treatment just for this page. */
    position: relative;
    overflow: hidden;
    background:
      /* Faint CRT/terminal scanline texture — the "data readout" feel
         from the reference mockup, kept subtle enough not to compete
         with the actual price/feature text sitting on top of it. */
      repeating-linear-gradient(
        0deg,
        color-mix(in oklab, var(--color-neon) 5%, transparent) 0px,
        transparent 1px,
        transparent 3px
      ),
      linear-gradient(165deg, color-mix(in oklab, white 6%, transparent), transparent 40%),
      color-mix(in oklab, var(--color-surface) 60%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-neon-soft) 16%, var(--color-border-strong));
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow:
      0 20px 44px -20px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 0 color-mix(in oklab, white 10%, transparent),
      inset 0 -1px 0 0 rgba(0, 0, 0, 0.3);
    transform: translateZ(0) rotateX(0deg);
    transform-style: preserve-3d;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  /* Terminal/HUD title bar — status dots + a mono "device id" label,
     reusing the site's existing terminal motif (shahid@security:~$,
     // eyebrows) rather than inventing a new visual language. */
  .pricing-card__bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: -0.25rem -0.25rem 1rem -0.25rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.6rem;
    background: color-mix(in oklab, black 22%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-neon-soft) 14%, transparent);
  }

  .pricing-card__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-neon) 55%, transparent);
    box-shadow: 0 0 6px 0 color-mix(in oklab, var(--color-neon) 70%, transparent);
  }

  .pricing-card__dot:last-of-type {
    background: var(--color-success, var(--color-neon));
    box-shadow: 0 0 6px 0 color-mix(in oklab, var(--color-success, var(--color-neon)) 70%, transparent);
  }

  .pricing-card__bar-label {
    margin-left: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .pricing-card:hover {
    transform: translateY(-6px) rotateX(2deg);
    border-color: color-mix(in oklab, var(--color-neon-soft) 45%, var(--color-border-strong));
    box-shadow:
      0 28px 56px -20px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 0 color-mix(in oklab, white 14%, transparent),
      inset 0 -1px 0 0 rgba(0, 0, 0, 0.3),
      0 0 36px -8px color-mix(in oklab, var(--color-neon-soft) 40%, transparent);
  }

  .pricing-card--recommended {
    border-color: color-mix(in oklab, var(--color-neon) 55%, var(--color-border-strong));
    transform: translateY(-4px);
    animation: pricing-card-glow 3.2s ease-in-out infinite;
  }

  .pricing-card--recommended:hover {
    transform: translateY(-9px) rotateX(2deg);
    animation-play-state: paused;
  }

  /* Slow glow breathing on the recommended card only — the "this one's
     live" HUD touch from the reference mockup, pausing on hover so it
     doesn't fight the lift/border-brighten transition above. */
  @keyframes pricing-card-glow {
    0%,
    100% {
      box-shadow:
        0 24px 52px -18px rgba(0, 0, 0, 0.7),
        inset 0 1px 0 0 color-mix(in oklab, white 14%, transparent),
        0 0 0 1px color-mix(in oklab, var(--color-neon) 35%, transparent),
        0 0 32px -6px color-mix(in oklab, var(--color-neon-soft) 35%, transparent);
    }
    50% {
      box-shadow:
        0 24px 52px -18px rgba(0, 0, 0, 0.7),
        inset 0 1px 0 0 color-mix(in oklab, white 14%, transparent),
        0 0 0 1px color-mix(in oklab, var(--color-neon) 55%, transparent),
        0 0 44px -4px color-mix(in oklab, var(--color-neon-soft) 55%, transparent);
    }
  }

  .pricing-card__badge {
    align-self: flex-start;
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-bg);
    background: linear-gradient(135deg, var(--color-neon-soft), var(--color-neon));
  }

  .addon-card {
    border-radius: 1rem;
    padding: 1.1rem;
    background: color-mix(in oklab, var(--color-surface) 50%, transparent);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .addon-card:hover {
    border-color: color-mix(in oklab, var(--color-neon-soft) 40%, var(--color-border-strong));
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card,
    .pricing-card:hover,
    .pricing-card--recommended,
    .pricing-card--recommended:hover,
    .addon-card:hover {
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Not using define:vars here — confirmed by a real headless-browser
  // test (not assumed) that Astro's CSP feature (astro.config.mjs ->
  // security.csp) hashes a define:vars script's pre-substitution
  // template, not the actual post-substitution content the browser
  // receives, so the computed hash never matches and the whole script
  // gets silently blocked ("Executing inline script violates... CSP").
  // Confirmed the identical failure on the already-deployed /book/
  // page's BookingForm.astro, which uses the same pattern — fixed
  // there too. ADMIN_API_BASE is a build-time constant anyway, so it
  // doesn't need injecting as a variable; a literal avoids the bug
  // entirely rather than working around Astro's CSP internals.
  const ADMIN_API_BASE = 'https://admin.shahidiqbal.com';
  const CURRENCY_STORAGE_KEY = 'shahid-security-currency';
  const select = document.getElementById('currency-select') as HTMLSelectElement | null;
  const note = document.getElementById('currency-note');

  function getStoredCurrency(): string | null {
    try {
      return localStorage.getItem(CURRENCY_STORAGE_KEY);
    } catch {
      return null;
    }
  }
  function storeCurrency(code: string): void {
    try {
      localStorage.setItem(CURRENCY_STORAGE_KEY, code);
    } catch {
      /* localStorage unavailable (private mode, blocked) — selection just won't persist across reloads. */
    }
  }

  async function detectCurrency(): Promise<string> {
    try {
      const localeRegion = (Intl.NumberFormat().resolvedOptions().locale || '').split('-')[1] || '';
      const res = await fetch(`${ADMIN_API_BASE}/api/public/geo-currency${localeRegion ? `?localeRegion=${encodeURIComponent(localeRegion)}` : ''}`);
      const d = await res.json();
      return d.currencyCode || 'USD';
    } catch {
      return 'USD';
    }
  }

  async function applyCurrency(currency: string): Promise<void> {
    if (currency === 'USD') {
      document.querySelectorAll('[data-price-converted]').forEach((el) => (el.textContent = ''));
      if (note) note.textContent = '';
      return;
    }
    try {
      const res = await fetch(`${ADMIN_API_BASE}/api/public/pricing-plans?currency=${encodeURIComponent(currency)}`);
      const d = await res.json();
      if (d.requestedCurrency !== currency) return; // server fell back (e.g. no cached rate) — leave USD-only display

      const byPlan: Record<string, any> = Object.fromEntries((d.plans || []).map((p: any) => [p.slug, p]));
      const byAddOn: Record<string, any> = Object.fromEntries((d.addOns || []).map((a: any) => [a.slug, a]));

      document.querySelectorAll('[data-plan-slug]').forEach((card) => {
        const slug = card.getAttribute('data-plan-slug') ?? '';
        const plan = byPlan[slug];
        const convertedEl = card.querySelector('[data-price-converted]');
        if (plan && plan.converted && !plan.converted.usedFallback && convertedEl) {
          convertedEl.textContent = `≈ ${plan.converted.currencyCode} ${plan.converted.amount.toLocaleString('en-US', { maximumFractionDigits: 0 })}${plan.monthlyPriceUsd !== null ? '/mo' : ''}`;
        }
      });
      document.querySelectorAll('[data-addon-slug]').forEach((row) => {
        const slug = row.getAttribute('data-addon-slug') ?? '';
        const addOn = byAddOn[slug];
        const convertedEl = row.querySelector('[data-price-converted]');
        if (addOn && addOn.converted && !addOn.converted.usedFallback && convertedEl) {
          convertedEl.textContent = `(≈ ${addOn.converted.currencyCode} ${addOn.converted.amount.toLocaleString('en-US', { maximumFractionDigits: 0 })})`;
        }
      });
      // Consultation fee block isn't inside a [data-plan-slug] card — update it directly.
      const consultEl = document.querySelector('.pricing-card [data-price-converted][data-price-usd]');
      if (consultEl && d.consultation?.converted && !d.consultation.converted.usedFallback) {
        consultEl.textContent = ` (≈ ${d.consultation.converted.currencyCode} ${d.consultation.converted.amount.toLocaleString('en-US', { maximumFractionDigits: 2 })})`;
      }

      if (note) note.textContent = 'Local-currency figures are estimates. The authoritative price and actual charge are always in USD.';
    } catch {
      if (note) note.textContent = '';
    }
  }

  (async () => {
    const stored = getStoredCurrency();
    const initial = stored || (await detectCurrency());
    // Reflect the resolved currency in the dropdown itself — leaving it
    // stuck on the literal "Auto-detect" label after detection already
    // ran was confusing (reported directly: a GB visitor expects to see
    // "GBP" selected, not "Auto-detect" with no visible indication
    // anything happened). Only fall back to the "Auto-detect" option if
    // the resolved currency genuinely isn't one of the dropdown's
    // choices (unsupported currency, or detection itself failed).
    if (select) {
      const hasOption = Boolean(initial) && [...select.options].some((o) => o.value === initial);
      select.value = hasOption ? initial : 'auto';
    }
    if (initial !== 'USD') await applyCurrency(initial);
  })();

  select?.addEventListener('change', async (e) => {
    const value = (e.target as HTMLSelectElement).value;
    if (value === 'auto') {
      try {
        localStorage.removeItem(CURRENCY_STORAGE_KEY);
      } catch {
        /* ignore */
      }
      const detected = await detectCurrency();
      await applyCurrency(detected);
      return;
    }
    storeCurrency(value);
    await applyCurrency(value);
  });
</script>
