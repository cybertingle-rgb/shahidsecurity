---
import { site, mailtoLink, telLink } from '@/lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Security',
    links: [
      { label: 'Penetration Testing', href: '/services/penetration-testing/' },
      { label: 'Vulnerability Assessment', href: '/services/vulnerability-assessment/' },
      { label: 'Network & Cloud Security', href: '/services/network-cloud-security/' },
      { label: 'Compliance & Risk', href: '/services/compliance-risk-assessment/' },
      { label: 'Incident Response', href: '/services/incident-response/' },
      { label: 'Monitoring & Training', href: '/services/monitoring-training/' },
    ],
  },
  {
    title: 'Build',
    links: [
      { label: 'Website Development', href: '/services/secure-website-development/' },
      { label: 'Software Development', href: '/services/custom-software-development/' },
      { label: 'AI Automation', href: '/services/ai-automation/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Case Studies', href: '/case-studies/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Book a consultation', href: '/book/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy/' },
      { label: 'Terms of Service', href: '/terms/' },
      { label: 'Responsible Disclosure', href: '/responsible-disclosure/' },
    ],
  },
];
---

<footer class="border-t border-(--color-border) bg-(--color-bg-elevated)">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" aria-label="Shahid Security home" class="block">
          <picture class="hidden sm:block">
            <source srcset="/brand/logo-horizontal-dark-bg-nav.webp" type="image/webp" />
            <img
              src="/brand/logo-horizontal-dark-bg-nav.png"
              alt="Shahid Security"
              width="340"
              height="162"
              class="h-9 w-auto"
            />
          </picture>
          <picture class="block sm:hidden">
            <source srcset="/brand/logo-stacked-dark-bg-sm.webp" type="image/webp" />
            <img
              src="/brand/logo-stacked-dark-bg-sm.png"
              alt="Shahid Security"
              width="320"
              height="502"
              class="h-24 w-auto"
            />
          </picture>
        </a>
        <p class="mt-3 text-sm text-(--color-text-muted) font-mono">{site.tagline}</p>
        <p class="mt-2 text-sm text-(--color-text-muted)">
          <a href={telLink()} class="inline-block py-1.5 hover:text-(--color-neon)">
            {site.phoneDisplay}
          </a>
        </p>
        <p class="text-sm text-(--color-text-muted)">
          <a href={mailtoLink()} class="inline-block py-1.5 hover:text-(--color-neon)">
            {site.email}
          </a>
        </p>
        <p class="mt-2 text-xs text-(--color-text-muted)">
          {site.legalEntity}
          <br />
          {site.registeredAddress.full}
        </p>
      </div>
      {columns.map((col) => (
        <div>
          <p class="eyebrow mb-4">{col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block py-1.5 text-sm text-(--color-text-muted) hover:text-(--color-neon)"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-(--color-border) pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-(--color-text-muted) font-mono">
        &copy; {year} {site.name}. All rights reserved.
      </p>
      <div class="flex gap-2 -my-2.5">
        <a
          href={site.social.facebook}
          class="inline-block px-2 py-2.5 text-(--color-text-muted) hover:text-(--color-neon) text-xs font-mono"
          rel="me noopener"
          target="_blank"
        >
          Facebook
        </a>
        <a
          href={site.social.instagram}
          class="inline-block px-2 py-2.5 text-(--color-text-muted) hover:text-(--color-neon) text-xs font-mono"
          rel="me noopener"
          target="_blank"
        >
          Instagram
        </a>
        <a
          href={site.social.x}
          class="inline-block px-2 py-2.5 text-(--color-text-muted) hover:text-(--color-neon) text-xs font-mono"
          rel="me noopener"
          target="_blank"
        >
          X
        </a>
      </div>
    </div>
  </div>
</footer>
