---
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step, index) => (
    <li class="glass-card p-6">
      <span class="font-mono text-xs text-(--color-neon)">
        {`// ${String(index + 1).padStart(2, '0')}`}
      </span>
      <h3 class="mt-2 font-display text-base font-semibold text-(--color-text)">{step.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-(--color-text-muted)">{step.text}</p>
    </li>
  ))}
</ol>
