---
import { Icon } from 'astro-icon/components';
import { SUPPORTED_LOCALES, localeMeta } from '@/lib/i18n';
---

<div class="lang-switcher" data-lang-switcher>
  <button
    type="button"
    class="lang-switcher-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    data-lang-trigger
  >
    <span data-lang-flag aria-hidden="true">
      {localeMeta.en.flag}
    </span>
    <span class="sr-only" data-lang-current-label>
      {localeMeta.en.label}
    </span>
    <Icon name="lucide:chevron-down" class="size-3" aria-hidden="true" />
  </button>
  <ul class="lang-switcher-menu" role="listbox" data-lang-menu hidden>
    {SUPPORTED_LOCALES.map((code) => (
      <li role="option" data-locale={code}>
        <button type="button" class="lang-switcher-option" data-lang-option={code}>
          <span aria-hidden="true">{localeMeta[code].flag}</span>
          <span>{localeMeta[code].label}</span>
        </button>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-switcher-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .lang-switcher-trigger:hover {
    border-color: var(--color-neon);
    color: var(--color-neon);
  }

  .lang-switcher-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 9rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    padding: 0.35rem;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.6);
    z-index: 60;
  }

  .lang-switcher-option {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: left;
  }

  .lang-switcher-option:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  li[data-locale].is-active .lang-switcher-option {
    color: var(--color-neon);
  }
</style>

<script>
  // Deliberately no `import` from '@/lib/i18n' here: Astro/Vite code-splits
  // an imported module's client script into its own chunk, and this
  // project's CSP auto-hasher has already been found (see ReportFlipbook's
  // styles) not to catch every such chunk, causing a silent CSP block. The
  // handful of constants below are duplicated from src/lib/i18n.ts rather
  // than imported, to keep this whole script as one inline, hashed unit.
  type Locale = 'en' | 'ar' | 'pt';
  const SUPPORTED_LOCALES: Locale[] = ['en', 'ar', 'pt'];
  const DEFAULT_LOCALE: Locale = 'en';

  const STORAGE_KEY = 'shahid-lang';
  const dictEl = document.getElementById('i18n-dictionary');
  const dictionary: Record<Locale, Record<string, string>> = dictEl
    ? JSON.parse(dictEl.textContent || '{}')
    : ({} as Record<Locale, Record<string, string>>);

  // Kept in sync with src/lib/i18n.ts's localeMeta — duplicated here so the
  // client script has no runtime import of non-type values to bundle awkwardly.
  const FLAGS: Record<Locale, string> = { en: '🇬🇧', ar: '🇸🇦', pt: '🇵🇹' };
  const LABELS: Record<Locale, string> = { en: 'English', ar: 'العربية', pt: 'Português' };

  interface LocaleChoice {
    locale: Locale;
    flag: string;
  }

  // Builds an accurate country flag emoji from any ISO 3166-1 alpha-2 region
  // code (e.g. "PK" -> 🇵🇰, "BR" -> 🇧🇷) using the Unicode Regional Indicator
  // Symbol trick — covers any region the browser reports, not just a
  // hardcoded handful, so the flag matches the visitor's actual locale
  // (e.g. an "en-PK" browser shows 🇵🇰, not a generic English flag).
  function regionFlagEmoji(region: string): string | null {
    if (!/^[A-Za-z]{2}$/.test(region)) return null;
    const codePoints = [...region.toUpperCase()].map((c) => 0x1f1e6 + (c.charCodeAt(0) - 65));
    return String.fromCodePoint(...codePoints);
  }

  // Auto-detection always picks the visitor's browser LANGUAGE (default:
  // English) — never their country/geo-IP, which a static site can't read
  // anyway. The flag shown alongside it is a separate, cosmetic detail: it
  // reflects whatever region tag came with that language (e.g. "ar-AE"),
  // falling back to a sensible default flag if the browser didn't supply
  // one or reported something we can't render as a flag.
  function detectLocaleChoice(): LocaleChoice {
    const langs =
      navigator.languages && navigator.languages.length
        ? navigator.languages
        : [navigator.language];
    for (const raw of langs) {
      const [langPart, regionPart] = raw.split('-');
      const base = langPart.toLowerCase();
      if ((SUPPORTED_LOCALES as readonly string[]).includes(base)) {
        const locale = base as Locale;
        const flag = regionPart ? regionFlagEmoji(regionPart) : null;
        return { locale, flag: flag ?? FLAGS[locale] };
      }
    }
    return { locale: DEFAULT_LOCALE, flag: FLAGS[DEFAULT_LOCALE] };
  }

  function currentLocaleChoice(): LocaleChoice {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored) {
      try {
        const parsed = JSON.parse(stored);
        if (parsed && (SUPPORTED_LOCALES as readonly string[]).includes(parsed.locale)) {
          const locale = parsed.locale as Locale;
          return { locale, flag: parsed.flag || FLAGS[locale] };
        }
      } catch {
        // Ignore a corrupted/legacy stored value and fall through to detection.
      }
    }
    return detectLocaleChoice();
  }

  function applyLocale({ locale, flag }: LocaleChoice) {
    const strings = dictionary[locale] ?? dictionary[DEFAULT_LOCALE];
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      if (!key) return;
      const value = strings[key];
      if (value) el.textContent = value;
    });

    document.querySelectorAll<HTMLElement>('[data-lang-flag]').forEach((el) => {
      el.textContent = flag;
    });
    document.querySelectorAll<HTMLElement>('[data-lang-current-label]').forEach((el) => {
      el.textContent = LABELS[locale];
    });
    document.querySelectorAll<HTMLElement>('[data-locale]').forEach((li) => {
      li.classList.toggle('is-active', li.dataset.locale === locale);
    });

    document.documentElement.setAttribute('data-active-locale', locale);
    document.dispatchEvent(new CustomEvent('shahid:locale-change', { detail: { locale } }));
  }

  // A manual pick from the dropdown carries no region information (the
  // visitor chose a language, not a country), so it always uses that
  // language's default flag.
  function setLocale(locale: Locale) {
    const choice: LocaleChoice = { locale, flag: FLAGS[locale] };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(choice));
    applyLocale(choice);
  }

  // Apply immediately on every page load, before wiring up any single
  // switcher instance (there's only one in the header, but this keeps the
  // logic independent of how many switcher widgets exist on a page).
  applyLocale(currentLocaleChoice());

  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-lang-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-lang-menu]');

    trigger?.addEventListener('click', () => {
      const isOpen = !menu?.hidden;
      if (menu) menu.hidden = isOpen;
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const locale = btn.dataset.langOption as Locale;
        setLocale(locale);
        if (menu) menu.hidden = true;
        trigger?.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node) && menu && !menu.hidden) {
        menu.hidden = true;
        trigger?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
