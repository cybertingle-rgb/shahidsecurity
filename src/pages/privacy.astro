---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Prose from '@/components/Prose.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('legal', 'privacy');
if (!entry) throw new Error('Missing legal/privacy.mdx entry');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description="What the Shahid Security contact form collects, how long it's kept, and how it's used."
  path="/privacy/"
>
  <Section class="pt-12">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: entry.data.title, path: '/privacy/' },
      ]}
    />
    <SectionHeading
      as="h1"
      eyebrow="// legal"
      title={entry.data.title}
      intro={`Last updated ${entry.data.updatedAt.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}`}
    />
  </Section>
  <Section class="pt-0">
    <Prose>
      <Content />
    </Prose>
  </Section>
</BaseLayout>
