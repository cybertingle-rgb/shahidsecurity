# Public (client-exposed — safe to ship in the built HTML/JS) --------------

# Cloudflare Turnstile SITE key (public half). Leave empty in local dev —
# the contact form then skips rendering the widget and the PHP handler
# skips server-side verification too (see php/config-template).
PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Everything else (SMTP credentials, the Turnstile SECRET key,
# CONTACT_TO_EMAIL) is NOT set here. It lives in a PHP config file deployed
# OUTSIDE public_html — see php/config-template/shahid-security-config.php
# and php/README.md for the real, server-side configuration.
# ---------------------------------------------------------------------------
