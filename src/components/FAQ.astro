---
import { Icon } from 'astro-icon/components';

interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <div class="divide-y divide-(--color-border)">
    {items.map((item) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-medium text-(--color-text) marker:content-none">
          {item.q}
          <Icon
            name="lucide:chevron-down"
            class="size-4 flex-shrink-0 text-(--color-neon) transition-transform group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-(--color-text-muted)">{item.a}</p>
      </details>
    ))}
  </div>
)}
